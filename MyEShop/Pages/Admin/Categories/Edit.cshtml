@page
@model MyEShop.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
    Layout = "_AdminLayout";
}

<link href="~/css/categorystyle.css" rel="stylesheet" />

<!-- ============================================
     هدر صفحه
     ============================================ -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-purple mb-1">
            <i class="bi bi-pencil-square me-2"></i>
            ویرایش دسته‌بندی
        </h1>
        <p class="text-muted small mb-0">اطلاعات دسته‌بندی را ویرایش کنید</p>
    </div>
    <div>
        <a asp-page="Index" class="btn btn-outline-purple">
            <i class="bi bi-arrow-right me-1"></i>
            بازگشت به لیست
        </a>
    </div>
</div>

<!-- ============================================
     فرم ویرایش
     ============================================ -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-tag-fill me-2"></i>
                    اطلاعات دسته‌بندی
                </h5>
            </div>
            <div class="card-body p-3 p-md-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- فیلد مخفی ID -->
                    <input type="hidden" asp-for="Category.Id" />

                    <!-- نام دسته‌بندی -->
                    <div class="mb-3">
                        <label asp-for="Category.Name" class="form-label fw-semibold">
                            <i class="bi bi-tag-fill text-purple me-1"></i>
                            نام دسته‌بندی <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-purple-soft border-purple-soft">
                                <i class="bi bi-tag text-purple"></i>
                            </span>
                            <input asp-for="Category.Name"
                                   class="form-control"
                                   placeholder="نام دسته‌بندی"
                                   autocomplete="off" />
                        </div>
                        <span asp-validation-for="Category.Name" class="text-danger small"></span>
                    </div>

                    <!-- توضیحات -->
                    <div class="mb-4">
                        <label asp-for="Category.Description" class="form-label fw-semibold">
                            <i class="bi bi-card-text text-purple me-1"></i>
                            توضیحات
                        </label>
                        <textarea asp-for="Category.Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="توضیحات دسته‌بندی (اختیاری)"></textarea>
                        <span asp-validation-for="Category.Description" class="text-danger small"></span>
                    </div>

                    <!-- دکمه‌های عملیات -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end pt-3 border-top">
                        <a asp-page="Index" class="btn btn-light">
                            <i class="bi bi-x-circle me-1"></i>
                            انصراف
                        </a>
                        <button type="submit" class="btn btn-golden px-4">
                            <i class="bi bi-check2-circle me-1"></i>
                            ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}