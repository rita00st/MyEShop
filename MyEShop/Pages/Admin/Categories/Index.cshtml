@page
@model MyEShop.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
    Layout = "_AdminLayout";
}

<!-- ============================================
     هدر صفحه
     ============================================ -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-purple mb-1">
            <i class="bi bi-tags-fill me-2"></i>
            مدیریت دسته‌بندی‌ها
        </h1>
        <p class="text-muted small mb-0">افزودن و مدیریت دسته‌بندی‌های محصولات</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- ستون فرم افزودن -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
            <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-plus-circle-fill me-2"></i>
                    افزودن دسته‌بندی جدید
                </h5>
            </div>
            <div class="card-body p-3 p-md-4">
                <form method="post" asp-page-handler="AddCategory">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.Name" class="form-label fw-semibold">
                            <i class="bi bi-tag-fill text-purple me-1"></i>
                            نام دسته‌بندی <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-purple-soft border-purple-soft">
                                <i class="bi bi-tag text-purple"></i>
                            </span>
                            <input asp-for="NewCategory.Name"
                                   class="form-control"
                                   placeholder="مثلاً: الکترونیک"
                                   autocomplete="off" />
                        </div>
                        <span asp-validation-for="NewCategory.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.Description" class="form-label fw-semibold">
                            <i class="bi bi-card-text text-purple me-1"></i>
                            توضیحات
                        </label>
                        <textarea asp-for="NewCategory.Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="توضیحات دسته‌بندی (اختیاری)"></textarea>
                        <span asp-validation-for="NewCategory.Description" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-golden">
                            <i class="bi bi-check2-circle me-1"></i>
                            ثبت دسته‌بندی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ستون لیست دسته‌بندی‌ها -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul me-2"></i>
                        لیست دسته‌بندی‌ها
                    </h5>
                    <span class="badge bg-white text-purple">@Model.Categories.Count دسته</span>
                </div>
            </div>

            <div class="card-body p-0">
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    <!-- جدول دسکتاپ و تبلت -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center py-3" style="width: 60px;">#</th>
                                    <th class="text-center py-3">نام دسته‌بندی</th>
                                    <th class="text-center py-3 d-none d-lg-table-cell">توضیحات</th>
                                    <th class="text-center py-3" style="width: 120px;">تعداد محصول</th>
                                    <th class="text-center py-3" style="width: 150px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 1;
                                }
                                @foreach (var category in Model.Categories)
                                {
                                    <tr>
                                        <td class="text-center text-muted small">@counter</td>
                                        <td class="text-center">
                                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                                <div>
                                                    <h6 class="fw-bold">@category.Name</h6>
                                                    <small class="text-muted">#@category.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center d-none d-lg-table-cell">
                                            <small class="text-muted">
                                                @(string.IsNullOrWhiteSpace(category.Description) ? "بدون توضیحات" : category.Description)
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-purple-soft text-purple px-3 py-2">
                                                @(category.CategoryToProduct?.Count ?? 0) محصول
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a asp-page="Edit" asp-route-id="@category.Id"
                                                   class="btn btn-golden btn-sm rounded-5" title="ویرایش">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                                <!-- ✅ دکمه حذف با Modal -->
                                                <button type="button"
                                                        class="btn btn-danger btn-sm rounded-5"
                                                        title="حذف"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-category-id="@category.Id"
                                                        data-category-name="@category.Name">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    counter++;
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- کارت‌های موبایل -->
                    <div class="d-md-none p-3">
                        <div class="row g-3">
                            @foreach (var category in Model.Categories)
                            {
                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-3 category-card-mobile">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="category-icon-md bg-purple-soft rounded-circle">
                                                        <i class="bi bi-tag-fill text-purple fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-0">@category.Name</h6>
                                                        <small class="text-muted">#@category.Id</small>
                                                    </div>
                                                </div>
                                                <span class="badge bg-purple-soft text-purple">
                                                    @(category.CategoryToProduct?.Count ?? 0) محصول
                                                </span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(category.Description))
                                            {
                                                <div class="bg-light rounded-3 p-2 mb-3">
                                                    <small class="text-muted">
                                                        <i class="bi bi-card-text me-1"></i>
                                                        @category.Description
                                                    </small>
                                                </div>
                                            }

                                            <div class="d-flex gap-2">
                                                <a asp-page="Edit" asp-route-id="@category.Id"
                                                   class="btn btn-golden btn-sm flex-grow-1">
                                                    <i class="bi bi-pencil-fill me-1"></i> ویرایش
                                                </a>
                                                <!-- ✅ دکمه حذف با Modal -->
                                                <button type="button"
                                                        class="btn btn-danger btn-sm "
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-category-id="@category.Id"
                                                        data-category-name="@category.Name">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-tags fs-1 text-muted opacity-25"></i>
                        <h5 class="mt-3 text-muted">هیچ دسته‌بندی وجود ندارد!</h5>
                        <p class="text-muted small">از فرم سمت راست، اولین دسته‌بندی را اضافه کنید.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     ✅ Modal تأیید حذف
     ============================================ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <!-- هدر Modal -->
            <div class="modal-header bg-danger text-white rounded-top-4 border-0">
                <button type="button" class="btn-close btn-close-white mx-0" data-bs-dismiss="modal" aria-label="Close"></button>
                <h5 class="modal-title fw-bold text-center mx-auto" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    تأیید حذف
                </h5>
            </div>

            <!-- بدنه Modal -->
            <div class="modal-body p-4 text-center">
                <div class="delete-icon-wrapper mb-3">
                    <i class="bi bi-trash-fill text-danger"></i>
                </div>
                <h5 class="fw-bold mb-2">آیا از حذف این دسته‌بندی مطمئن هستید؟</h5>
                <p class="text-muted mb-1">دسته‌بندی:</p>
                <h6 class="fw-bold text-purple mb-3" id="deleteCategoryName">-</h6>
                <div class="alert alert-warning rounded-3 mb-0 small">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    این عمل قابل بازگشت نیست و محصولات مرتبط بدون دسته‌بندی خواهند شد.
                </div>
            </div>

            <!-- فوتر Modal -->
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    انصراف
                </button>
                <form method="post" asp-page-handler="DeleteCategory" id="deleteForm" class="d-inline">
                    <input type="hidden" name="id" id="deleteCategoryId" value="" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i>
                        بله، حذف شود
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     استایل‌های اختصاصی
     ============================================ -->
<style>
    .category-icon-sm {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .category-icon-md {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .category-card-mobile {
        transition: all 0.3s ease;
    }

        .category-card-mobile:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(106, 17, 203, 0.1) !important;
        }

    .table thead th {
        font-weight: 600;
        color: #495057;
        border-bottom: 2px solid #e9ecef;
        font-size: 0.9rem;
    }

    .table tbody tr {
        transition: all 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: rgba(106, 17, 203, 0.03);
        }

    .btn-danger {
        border-radius: 10px;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

    .form-control, textarea.form-control {
        border-radius: 10px;
        border: 1.5px solid #e8e0f0;
        padding: 0.65rem 1rem;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #6a11cb;
            box-shadow: 0 0 0 4px rgba(106, 17, 203, 0.08);
        }

    .input-group-text {
        border-radius: 10px 0 0 10px;
        border-right: none;
    }

    /* ✅ استایل Modal */
    #deleteModal .modal-content {
        overflow: hidden;
    }

    .delete-icon-wrapper {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(220, 53, 69, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: pulse 2s ease-in-out infinite;
    }

        .delete-icon-wrapper i {
            font-size: 2.5rem;
        }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    @@media (max-width: 991.98px) {
        .sticky-top {
            position: relative !important;
            top: 0 !important;
        }
    }

    @@media (max-width: 575.98px) {
        .category-icon-md {
            width: 38px;
            height: 38px;
        }

            .category-icon-md i {
                font-size: 0.95rem !important;
            }

        h1.h3 {
            font-size: 1.2rem;
        }

        .btn {
            font-size: 0.85rem;
        }

        .delete-icon-wrapper {
            width: 60px;
            height: 60px;
        }

            .delete-icon-wrapper i {
                font-size: 1.8rem;
            }
    }
</style>

<!-- ============================================
     اسکریپت Modal
     ============================================ -->
@section Scripts {
    <script>
        // ✅ وقتی Modal باز می‌شه، اطلاعات دسته‌بندی رو پر کن
        document.addEventListener('DOMContentLoaded', function () {
            const deleteModal = document.getElementById('deleteModal');

            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    // دکمه‌ای که Modal رو باز کرده
                    const button = event.relatedTarget;

                    // دریافت اطلاعات از data attributes
                    const categoryId = button.getAttribute('data-category-id');
                    const categoryName = button.getAttribute('data-category-name');

                    // پر کردن فیلدهای Modal
                    document.getElementById('deleteCategoryId').value = categoryId;
                    document.getElementById('deleteCategoryName').textContent = categoryName;
                });
            }
        });
    </script>
}