@page
@model MyEShop.Pages.Admin.Comments.IndexModel
@{
    ViewData["Title"] = "مدیریت نظرات";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- هدر -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">مدیریت نظرات</h1>
            <p class="text-muted mb-0 d-none d-sm-block">مشاهده، تأیید و مدیریت نظرات کاربران</p>
        </div>
        <a href="/Admin/Comments" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-clockwise me-1"></i> بازخوانی
        </a>
    </div>

    <!-- کارت‌های آمار -->
    <div class="row g-3 mb-4">
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-purple-10 text-purple rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-chat-dots"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">کل نظرات</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.TotalComments.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-success bg-opacity-10 text-success rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-check2-circle"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">تأیید شده</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.ApprovedCount.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-hourglass-split"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">در انتظار تأیید</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.PendingCount.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- پیام‌ها -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3">
            <i class="bi bi-check-circle me-1"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3">
            <i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- کارت اصلی -->
    <div class="card border-0 shadow-sm rounded-4">

        <!-- نوار فیلتر -->
        <div class="card-body border-bottom">
            <form method="get" class="row g-2">
                <div class="col-12 col-lg-5">
                    <input type="search" name="search" value="@Model.SearchTerm"
                           class="form-control rounded-pill"
                           placeholder="جستجو در متن نظر، نام کاربر یا محصول..." />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <select name="status" class="form-select rounded-pill">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="approved" selected="@(Model.Status == "approved" ? "selected" : null)">تأیید شده</option>
                        <option value="pending" selected="@(Model.Status == "pending" ? "selected" : null)">در انتظار تأیید</option>
                    </select>
                </div>
                <div class="col-12 col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-golden rounded-pill flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> اعمال
                    </button>
                    <a href="/Admin/Comments" class="btn btn-outline-secondary rounded-pill px-3" title="پاک‌سازی">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>

        @if (Model.Comments.Any())
        {
            <!-- جدول دسکتاپ -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-purple-10">
                        <tr>
                            <th class="px-3 py-3 text-purple fw-semibold">کاربر</th>
                            <th class="px-3 py-3 text-purple fw-semibold">محصول</th>
                            <th class="px-3 py-3 text-purple fw-semibold" style="max-width:300px;">متن نظر</th>
                            <th class="px-3 py-3 text-purple fw-semibold">تاریخ</th>
                            <th class="px-3 py-3 text-purple fw-semibold">وضعیت</th>
                            <th class="px-3 py-3 text-purple fw-semibold text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comment in Model.Comments)
                        {
                            <tr>
                                <td class="px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="bg-purple-10 text-purple rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                              style="width:36px;height:36px;font-size:0.9rem;">
                                            @if (comment.UserName == "بدون نام")
                                            {
                                                <i class="bi bi-person"></i>
                                            }
                                            else
                                            {
                                                @comment.UserName!.Substring(0, 1)
                                            }
                                        </span>
                                        <div style="min-width:0;">
                                            <div class="fw-semibold text-truncate" style="max-width:140px;">@comment.UserName</div>
                                            <small class="text-muted text-truncate d-block" style="max-width:140px;">@comment.UserEmail</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-3">
                                    <a href="/Home/Details/@comment.ProductId"
                                       class="text-decoration-none fw-semibold text-purple">
                                        @comment.ProductName
                                    </a>
                                </td>
                                <td class="px-3" style="max-width:300px;">
                                    <span class="d-inline-block text-truncate" style="max-width:100%;" title="@comment.Text">
                                        @comment.Text
                                    </span>
                                </td>
                                <td class="px-3 text-nowrap text-muted small">@comment.CreatedDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="px-3 text-nowrap">
                                    @if (comment.IsApproved)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                                            <i class="bi bi-check2-circle me-1"></i>تأیید شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">
                                            <i class="bi bi-hourglass me-1"></i>در انتظار
                                        </span>
                                    }
                                </td>
                                <td class="px-3 text-end text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <form method="post" asp-page-handler="ToggleApproval" asp-route-id="@comment.Id" class="m-0 d-inline-flex">
                                            @if (comment.IsApproved)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1" title="لغو تأیید">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1" title="تأیید">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            }
                                        </form>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@comment.Id" class="m-0 d-inline-flex"
                                              onsubmit="return confirm('آیا از حذف این نظر مطمئن هستید؟');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- کارت موبایل -->
            <div class="d-md-none p-3">
                @foreach (var comment in Model.Comments)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 bg-purple-10">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2" style="min-width:0;">
                                    <span class="bg-white text-purple rounded-circle d-inline-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                          style="width:32px;height:32px;font-size:0.85rem;">
                                        @if (comment.UserName == "بدون نام")
                                        {
                                            <i class="bi bi-person"></i>
                                        }
                                        else
                                        {
                                            @comment.UserName!.Substring(0, 1)
                                        }
                                    </span>
                                    <div style="min-width:0;">
                                        <div class="fw-semibold text-truncate">@comment.UserName</div>
                                        <small class="text-muted text-truncate d-block">@comment.UserEmail</small>
                                    </div>
                                </div>
                                @if (comment.IsApproved)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">تأیید شده</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">در انتظار</span>
                                }
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-box-seam me-1"></i>
                                    <a href="/Admin/Products/Details/@comment.ProductId" class="text-decoration-none text-purple fw-semibold">
                                        @comment.ProductName
                                    </a>
                                </small>
                            </div>

                            <p class="mb-2 small text-muted" style="white-space: pre-line;">@comment.Text</p>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                                <small class="text-muted">@comment.CreatedDate.ToString("yyyy/MM/dd HH:mm")</small>
                                <div class="d-flex gap-2">
                                    <form method="post" asp-page-handler="ToggleApproval" asp-route-id="@comment.Id" class="m-0">
                                        @if (comment.IsApproved)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1">
                                                <i class="bi bi-x-circle"></i><span class="d-none d-sm-inline ms-1">لغو تأیید</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1">
                                                <i class="bi bi-check2-circle"></i><span class="d-none d-sm-inline ms-1">تأیید</span>
                                            </button>
                                        }
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@comment.Id" class="m-0"
                                          onsubmit="return confirm('حذف شود؟');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1">
                                            <i class="bi bi-trash"></i><span class="d-none d-sm-inline ms-1">حذف</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- پجینیشن -->
            <div class="card-footer bg-white border-top-0 py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <small class="text-muted">
                        نمایش @Model.Comments.Count نظر از @Model.TotalComments — صفحه @Model.CurrentPage از @Model.TotalPages
                    </small>
                    @if (Model.TotalPages > 1)
                    {
                        <ul class="pagination pagination-sm mb-0 flex-wrap">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3" href="@Model.BuildPageUrl(Model.CurrentPage - 1)">قبلی</a>
                            </li>
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link rounded-pill px-3 @(i == Model.CurrentPage ? "bg-purple text-white border-0" : "")"
                                       href="@Model.BuildPageUrl(i)">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3" href="@Model.BuildPageUrl(Model.CurrentPage + 1)">بعدی</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card-body text-center py-5">
                <span class="bg-purple-10 text-purple rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-chat-square-text display-4"></i>
                </span>
                <h4 class="fw-bold mb-2">هیچ نظری یافت نشد</h4>
                <p class="text-muted mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <text>نتیجه‌ای برای فیلتر فعلی پیدا نشد. فیلترها را تغییر دهید.</text>
                    }
                    else
                    {
                        <text>هنوز نظری توسط کاربران ثبت نشده است.</text>
                    }
                </p>
            </div>
        }
    </div>
</div>