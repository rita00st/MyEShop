@page
@model MyEShop.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "داشبورد مدیریت";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- هدر -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">داشبورد مدیریت</h1>
            <p class="text-muted mb-0 d-none d-sm-block">نمای کلی فروشگاه، سفارشات و محصولات</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/Products/Create" class="btn btn-golden rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> محصول جدید
            </a>
            <a href="/Admin/Orders" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-receipt me-1"></i> سفارشات
            </a>
        </div>
    </div>

    <!-- کارت‌های آمار -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-purple-10 text-purple rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-box-seam"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">کل محصولات</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.TotalProducts.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-success bg-opacity-10 text-success rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-cart-check"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">کل سفارشات</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.TotalOrders.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-people"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">کاربران</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.TotalUsers.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-purple text-white rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-currency-dollar"></i>
                    </span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">درآمد کل (تومان)</small>
                        <h5 class="fw-bold mb-0 text-truncate" title="@Model.TotalRevenue.ToString("N0")">
                            @Model.TotalRevenue.ToString("N0")
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- نمودار فروش -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow me-2 text-purple"></i>فروش ۷ روز اخیر</h5>
                <small class="text-muted">مجموع مبلغ سفارشات پرداخت‌شده</small>
            </div>
            <span class="badge bg-purple-10 text-purple rounded-pill px-3 py-2 fs-6 fw-semibold">
                @Model.SalesChartData.Sum().ToString("N0") تومان
            </span>
        </div>
        <div class="card-body">
            <div style="height:300px; position:relative;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- آخرین سفارشات -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-purple"></i>آخرین سفارشات</h5>
                    <a href="/Admin/Orders" class="btn btn-sm btn-outline-secondary rounded-pill px-3">مشاهده همه</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-purple-10">
                                    <tr>
                                        <th class="px-3 py-3 text-purple fw-semibold">شماره</th>
                                        <th class="px-3 py-3 text-purple fw-semibold">مشتری</th>
                                        <th class="px-3 py-3 text-purple fw-semibold">مبلغ</th>
                                        <th class="px-3 py-3 text-purple fw-semibold">وضعیت</th>
                                        <th class="px-3 py-3 text-purple fw-semibold text-end">تاریخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td class="px-3 fw-semibold">#@order.OrderId</td>
                                            <td class="px-3">@order.User?.Name</td>
                                            <td class="px-3 text-nowrap">
                                                @order.OrderDetails.Sum(od => od.Count * od.Price).ToString("N0")
                                                <small class="text-muted">تومان</small>
                                            </td>
                                            <td class="px-3">
                                                @if (order.Finaly)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">پرداخت شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">در انتظار</span>
                                                }
                                            </td>
                                            <td class="px-3 text-nowrap text-muted small">@order.CreateDate.ToString("yyyy/MM/dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-4 text-muted"></i>
                            <p class="mt-3 text-muted">هنوز سفارشی ثبت نشده است.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- محصولات پرفروش -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-star me-2 text-purple"></i>محصولات پرفروش</h5>
                    <a href="/Admin/Products" class="btn btn-sm btn-outline-secondary rounded-pill px-3">مشاهده همه</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.TopProducts.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var product in Model.TopProducts)
                            {
                                <div class="list-group-item px-4 py-3 d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(product.ImagePath) ? "/images/no-image.png" : product.ImagePath)"
                                         alt="@product.Name" class="rounded-3 flex-shrink-0"
                                         width="48" height="48" style="object-fit:cover;" />
                                    <div class="flex-grow-1" style="min-width:0;">
                                        <div class="fw-semibold text-truncate">@product.Name</div>
                                        <small class="text-muted">@product.Item.Price.ToString("N0") تومان</small>
                                    </div>
                                    <span class="badge bg-purple-10 text-purple rounded-pill px-3 flex-shrink-0">
                                        @product.Item.QuantityInStock عدد
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-box-seam display-4 text-muted"></i>
                            <p class="mt-3 text-muted">محصولی وجود ندارد.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- دسترسی سریع -->
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <a href="/Admin/Products/Add" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none bg-purple-10">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-purple text-white rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-plus-circle"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0">افزودن محصول</h6>
                        <small class="text-muted">ایجاد محصول جدید</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a href="/Admin/Categories" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none bg-purple-10">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-success text-white rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-tags"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0">مدیریت دسته‌بندی‌ها</h6>
                        <small class="text-muted">افزودن یا ویرایش دسته‌ها</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a href="/Admin/ManagmentUser" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none bg-purple-10">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-warning text-white rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0">
                        <i class="bi bi-person-gear"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0">مدیریت کاربران</h6>
                        <small class="text-muted">مشاهده و ویرایش کاربران</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var canvas = document.getElementById('salesChart');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(138, 43, 226, 0.30)');
            gradient.addColorStop(1, 'rgba(138, 43, 226, 0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Json.Serialize(Model.SalesChartLabels),
                    datasets: [{
                        label: 'فروش',
                        data: @Json.Serialize(Model.SalesChartData),
                        borderColor: '#8a2be2',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#8a2be2',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#2d1b4e',
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            titleFont: { family: 'inherit', size: 13 },
                            bodyFont: { family: 'inherit', size: 14 },
                            callbacks: {
                                title: function (items) { return 'تاریخ: ' + items[0].label; },
                                label: function (context) {
                                    return 'فروش: ' + context.parsed.y.toLocaleString('fa-IR') + ' تومان';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'inherit', size: 12 }, color: '#6c757d' }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: {
                                font: { family: 'inherit', size: 12 },
                                color: '#6c757d',
                                callback: function (value) {
                                    return value.toLocaleString('fa-IR');
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>
}