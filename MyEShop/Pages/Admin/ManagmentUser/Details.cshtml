@page
@model MyEShop.Pages.Admin.ManagmentUser.DetailsModel
@{
    ViewData["Title"] = "جزئیات کاربر";
    Layout = "_AdminLayout";
    var displayName = string.IsNullOrWhiteSpace(Model.User?.Name) ? "بدون نام" : Model.User.Name;
}

<link href="~/css/detailsuser.css" rel="stylesheet" />


<!-- ============================================
     هدر صفحه
     ============================================ -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-purple mb-1">
            <i class="bi bi-person-vcard-fill me-2"></i>
            جزئیات کاربر
        </h1>
        <p class="text-muted small mb-0">مشاهده اطلاعات کامل کاربر</p>
    </div>
    <div class="d-flex flex-column flex-sm-row gap-2">
        <a asp-page="Edit" asp-route-id="@Model.User?.Id" class="btn btn-golden">
            <i class="bi bi-pencil-fill me-1"></i>
            ویرایش کاربر
        </a>
        <a asp-page="Index" class="btn btn-outline-purple">
            <i class="bi bi-arrow-right me-1"></i>
            بازگشت به لیست
        </a>
    </div>
</div>

@if (Model.User != null)
{
    <div class="row g-3 g-md-4">
        <!-- ============================================
             کارت پروفایل
             ============================================ -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <!-- هدر کارت -->
                <div class="bg-gradient-purple text-center py-4 py-md-5">
                    <div class="avatar-circle-lg bg-white text-purple mx-auto mb-3">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-1 px-2 @(string.IsNullOrWhiteSpace(Model.User.Name) ? "fst-italic opacity-75" : "")">
                        @displayName
                    </h4>
                    <small class="text-white-50">#@Model.User.Id</small>
                </div>

                <!-- بدنه کارت -->
                <div class="card-body p-3 p-md-4 bg-light">
                    <!-- نقش کاربر -->
                    <div class="text-center mb-4">
                        @if (Model.User.IsAdmin)
                        {
                            <span class="badge bg-golden-soft text-golden-dark px-4 py-2">
                                <i class="bi bi-shield-check me-1"></i>
                                مدیر سیستم
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-purple-light-10 text-purple px-4 py-2">
                                <i class="bi bi-person me-1"></i>
                                کاربر عادی
                            </span>
                        }
                    </div>

                    <!-- اطلاعات سریع -->
                    <div class="bg-purple-25 rounded-3 p-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-wrapper-sm bg-white rounded-3">
                                <i class="bi bi-envelope-fill text-purple"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <small class="text-muted d-block">ایمیل</small>
                                <span class="fw-bold text-dark small text-truncate d-block" dir="ltr">
                                    @Model.User.Email
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-golden-soft rounded-3 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-wrapper-sm bg-white rounded-3">
                                <i class="bi bi-calendar-check-fill text-golden-dark"></i>
                            </div>
                            <div class="flex-grow-1">
                                <small class="text-muted d-block">تاریخ ثبت‌نام</small>
                                <span class="fw-bold text-dark">
                                    @Model.User.RejesterDate.ToString("yyyy/MM/dd")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================
             اطلاعات کامل
             ============================================ -->
        <div class="col-12 col-lg-8">
            <!-- کارت اطلاعات شخصی -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge me-2"></i>
                        اطلاعات شخصی
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3">
                        <!-- نام -->
                        <div class="col-12 col-sm-6">
                            <div class="detail-item bg-light rounded-3 p-3 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-person-fill text-purple"></i>
                                    <small class="text-muted">نام کاربر</small>
                                </div>
                                <h6 class="fw-bold mb-0 @(string.IsNullOrWhiteSpace(Model.User.Name) ? "text-muted fst-italic" : "")">
                                    @displayName
                                </h6>
                            </div>
                        </div>

                        <!-- ایمیل -->
                        <div class="col-12 col-sm-6">
                            <div class="detail-item bg-light rounded-3 p-3 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-envelope-fill text-purple"></i>
                                    <small class="text-muted">ایمیل</small>
                                </div>
                                <h6 class="fw-bold mb-0 small text-truncate" dir="ltr">
                                    @Model.User.Email
                                </h6>
                            </div>
                        </div>

                        <!-- نقش -->
                        <div class="col-12 col-sm-6">
                            <div class="detail-item bg-light rounded-3 p-3 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-shield-fill text-purple"></i>
                                    <small class="text-muted">نقش کاربری</small>
                                </div>
                                @if (Model.User.IsAdmin)
                                {
                                    <h6 class="fw-bold mb-0 text-golden-dark">
                                        <i class="bi bi-shield-check me-1"></i>
                                        مدیر سیستم
                                    </h6>
                                }
                                else
                                {
                                    <h6 class="fw-bold mb-0 text-purple">
                                        <i class="bi bi-person me-1"></i>
                                        کاربر عادی
                                    </h6>
                                }
                            </div>
                        </div>

                        <!-- تاریخ ثبت‌نام -->
                        <div class="col-12 col-sm-6">
                            <div class="detail-item bg-light rounded-3 p-3 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-calendar-fill text-purple"></i>
                                    <small class="text-muted">تاریخ ثبت‌نام</small>
                                </div>
                                <h6 class="fw-bold mb-0">
                                    @Model.User.RejesterDate.ToString("yyyy/MM/dd")
                                </h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- کارت اطلاعات سیستمی -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-gear-fill me-2"></i>
                        اطلاعات سیستمی
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-2 g-md-3">
                        <div class="col-6 col-md-3">
                            <div class="text-center p-2">
                                <div class="stat-icon-sm bg-purple-10 rounded-circle mx-auto mb-2">
                                    <i class="bi bi-hash text-purple"></i>
                                </div>
                                <small class="text-muted d-block">شناسه</small>
                                <span class="fw-bold text-purple">#@Model.User.Id</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-2">
                                <div class="stat-icon-sm bg-teal-10 rounded-circle mx-auto mb-2">
                                    <i class="bi bi-check-circle text-teal"></i>
                                </div>
                                <small class="text-muted d-block">وضعیت</small>
                                <span class="fw-bold text-teal">فعال</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-2">
                                <div class="stat-icon-sm bg-golden-25 rounded-circle mx-auto mb-2">
                                    <i class="bi bi-clock-history text-golden-dark"></i>
                                </div>
                                <small class="text-muted d-block">تاریخ عضویت</small>
                                <span class="fw-bold small">
                                    @Model.User.RejesterDate.ToString("MM/dd")
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-2">
                                <div class="stat-icon-sm bg-pink-10 rounded-circle mx-auto mb-2">
                                    <i class="bi bi-person-check text-pink"></i>
                                </div>
                                <small class="text-muted d-block">نوع</small>
                                <span class="fw-bold text-pink">
                                    @(Model.User.IsAdmin ? "مدیر" : "کاربر")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-person-x fs-1 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">کاربر مورد نظر یافت نشد!</h5>
            <a asp-page="Index" class="btn btn-golden mt-3">
                <i class="bi bi-arrow-right me-1"></i>
                بازگشت به لیست کاربران
            </a>
        </div>
    </div>
}

