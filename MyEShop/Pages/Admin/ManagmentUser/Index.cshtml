@page
@model MyEShop.Pages.Admin.ManagmentUser.IndexModel
@{
    ViewData["Title"] = "مدیریت کاربران";
    Layout = "_AdminLayout";
}

<!-- ============================================
     هدر صفحه
     ============================================ -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-purple mb-1">
            <i class="bi bi-people-fill me-2"></i>
            مدیریت کاربران
        </h1>
        <p class="text-muted small mb-0">مدیریت، ویرایش و حذف کاربران فروشگاه</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Create" class="btn btn-golden">
            <i class="bi bi-person-plus-fill me-1"></i>
            افزودن کاربر جدید
        </a>
    </div>
</div>

<!-- ============================================
     کارت‌های آماری
     ============================================ -->
<div class="row g-3 g-md-4 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 stat-card">
            <div class="card-body text-center p-3 p-md-4">
                <div class="stat-icon bg-purple-soft rounded-circle mx-auto mb-3">
                    <i class="bi bi-people-fill fs-3 text-purple"></i>
                </div>
                <h2 class="fw-bold text-purple mb-0">@Model.TotalUsers</h2>
                <p class="text-muted small mb-0">کل کاربران</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 stat-card">
            <div class="card-body text-center p-3 p-md-4">
                <div class="stat-icon bg-golden-soft rounded-circle mx-auto mb-3">
                    <i class="bi bi-shield-check fs-3 text-golden-dark"></i>
                </div>
                <h2 class="fw-bold text-golden-dark mb-0">@Model.AdminCount</h2>
                <p class="text-muted small mb-0">مدیران</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 stat-card">
            <div class="card-body text-center p-3 p-md-4">
                <div class="stat-icon bg-teal-soft rounded-circle mx-auto mb-3">
                    <i class="bi bi-person-check-fill fs-3 text-teal"></i>
                </div>
                <h2 class="fw-bold text-teal mb-0">@Model.NormalUserCount</h2>
                <p class="text-muted small mb-0">کاربران عادی</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 stat-card">
            <div class="card-body text-center p-3 p-md-4">
                <div class="stat-icon bg-pink-soft rounded-circle mx-auto mb-3">
                    <i class="bi bi-calendar-check-fill fs-3 text-pink"></i>
                </div>
                <h2 class="fw-bold text-pink mb-0">@Model.TodayRegistrations</h2>
                <p class="text-muted small mb-0">ثبت‌نام امروز</p>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     جدول کاربران - دسکتاپ
     ============================================ -->
<div class="card border-0 shadow-sm rounded-4 d-none d-lg-block">
    <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-table me-2"></i>
                لیست کاربران
            </h5>
            <span class="badge bg-white text-purple">@Model.TotalUsers کاربر</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Users != null && Model.Users.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center py-3">#</th>
                            <th class="text-center py-3">کاربر</th>
                            <th class="text-center py-3">ایمیل</th>
                            <th class="text-center py-3">تاریخ ثبت‌نام</th>
                            <th class="text-center py-3">نقش</th>
                            <th class="text-center py-3">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var user in Model.Users)
                        {
                            var displayName = string.IsNullOrWhiteSpace(user.Name) ? "بدون نام" : user.Name;
                            <tr>
                                <td class="text-center">@counter</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 justify-content-center">
                                        <div class="user-avatar-sm bg-purple-soft rounded-circle">
                                            <i class="bi bi-person-fill text-purple"></i>
                                        </div>
                                        <div class="text-end">
                                            <h6 class="mb-0 fw-bold @(string.IsNullOrWhiteSpace(user.Name) ? "text-muted fst-italic" : "")">
                                                @displayName
                                            </h6>
                                            <small class="text-muted">#@user.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <small class="text-muted">@user.Email</small>
                                </td>
                                <td class="text-center">
                                    <small>@user.RejesterDate.ToString("yyyy/MM/dd")</small>
                                </td>
                                <td class="text-center">
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge bg-golden-soft text-golden-dark px-3 py-2">
                                            <i class="bi bi-shield-check me-1"></i> مدیر
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-purple-soft text-purple px-3 py-2">
                                            <i class="bi bi-person me-1"></i> کاربر عادی
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                                        <a asp-page="Details" asp-route-id="@user.Id"
                                           class="btn btn-outline-purple btn-sm" title="جزئیات">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@user.Id"
                                           class="btn btn-golden btn-sm" title="ویرایش">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@user.Id"
                                           class="btn btn-danger btn-sm" title="حذف"
                                           onclick="return confirm('آیا از حذف کاربر @displayName مطمئن هستید؟')">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted opacity-25"></i>
                <h5 class="mt-3 text-muted">کاربری یافت نشد!</h5>
                <a asp-page="Create" class="btn btn-golden mt-2">
                    <i class="bi bi-person-plus-fill me-1"></i> افزودن اولین کاربر
                </a>
            </div>
        }
    </div>
</div>

<!-- ============================================
     کارت‌های کاربران - موبایل و تبلت
     ============================================ -->
<div class="d-lg-none">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-purple mb-0">
            <i class="bi bi-list-ul me-2"></i>
            لیست کاربران
        </h5>
        <span class="badge bg-purple-soft text-purple">@Model.TotalUsers کاربر</span>
    </div>

    @if (Model.Users != null && Model.Users.Any())
    {
        <div class="row g-3">
            @foreach (var user in Model.Users)
            {
                var displayName = string.IsNullOrWhiteSpace(user.Name) ? "بدون نام" : user.Name;
                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 user-card h-100">
                        <div class="card-body p-3">
                            <!-- هدر کارت -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="user-avatar-lg bg-purple-soft rounded-circle">
                                    <i class="bi bi-person-fill text-purple"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-0 @(string.IsNullOrWhiteSpace(user.Name) ? "text-muted fst-italic" : "")">
                                        @displayName
                                    </h6>
                                    <small class="text-muted">@user.Email</small>
                                </div>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge bg-golden-soft text-golden-dark">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                }
                            </div>

                            <!-- اطلاعات -->
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded-3">
                                <div class="text-center flex-grow-1">
                                    <small class="text-muted d-block">کد کاربر</small>
                                    <span class="fw-bold text-purple">#@user.Id</span>
                                </div>
                                <div class="border-end" style="height: 30px;"></div>
                                <div class="text-center flex-grow-1">
                                    <small class="text-muted d-block">تاریخ ثبت‌نام</small>
                                    <span class="fw-bold small">@user.RejesterDate.ToString("yyyy/MM/dd")</span>
                                </div>
                            </div>

                            <!-- نقش -->
                            <div class="text-center mb-3">
                                @if (user.IsAdmin)
                                {
                                    <span class="badge bg-golden-soft text-golden-dark px-3 py-2 w-100">
                                        <i class="bi bi-shield-check me-1"></i> مدیر سیستم
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-purple-soft text-purple px-3 py-2 w-100">
                                        <i class="bi bi-person me-1"></i> کاربر عادی
                                    </span>
                                }
                            </div>

                            <!-- دکمه‌ها -->
                            <div class="d-flex gap-2">
                                <a asp-page="Details" asp-route-id="@user.Id"
                                   class="btn btn-outline-purple btn-sm flex-grow-1">
                                    <i class="bi bi-eye"></i> جزئیات
                                </a>
                                <a asp-page="Edit" asp-route-id="@user.Id"
                                   class="btn btn-golden btn-sm flex-grow-1">
                                    <i class="bi bi-pencil-fill"></i> ویرایش
                                </a>
                                <a asp-page="Delete" asp-route-id="@user.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('آیا از حذف کاربر @displayName مطمئن هستید؟')">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="bi bi-people fs-1 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">کاربری یافت نشد!</h5>
            <a asp-page="Create" class="btn btn-golden mt-2">
                <i class="bi bi-person-plus-fill me-1"></i> افزودن اولین کاربر
            </a>
        </div>
    }
</div>

<!-- ============================================
     استایل‌های اختصاصی
     ============================================ -->
<style>
    /* رنگ‌ها */
    .text-purple {
        color: #6a11cb;
    }

    .text-golden-dark {
        color: #b8860b;
    }

    .text-teal {
        color: #20c997;
    }

    .text-pink {
        color: #e83e8c;
    }

    .bg-purple-soft {
        background: rgba(106, 17, 203, 0.1);
    }

    .bg-golden-soft {
        background: rgba(255, 215, 0, 0.15);
    }

    .bg-teal-soft {
        background: rgba(32, 201, 151, 0.1);
    }

    .bg-pink-soft {
        background: rgba(232, 62, 140, 0.1);
    }

    .bg-gradient-purple {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    }

    /* دکمه‌ها */
    .btn-golden {
        background: linear-gradient(135deg, #ffd700 0%, #ffc107 100%);
        color: #333;
        border: none;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .btn-golden:hover {
            background: linear-gradient(135deg, #ffc107 0%, #ffb300 100%);
            color: #333;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 215, 0, 0.3);
        }

    .btn-outline-purple {
        border: 1.5px solid #6a11cb;
        color: #6a11cb;
        background: transparent;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .btn-outline-purple:hover {
            background: #6a11cb;
            color: #fff;
            transform: translateY(-2px);
        }

    .btn-danger {
        border-radius: 10px;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

    /* کارت‌های آماری */
    .stat-card {
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px -12px rgba(106, 17, 203, 0.15) !important;
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s ease;
    }

    .stat-card:hover .stat-icon {
        transform: scale(1.08) rotate(-5deg);
    }

    /* جدول */
    .table thead th {
        font-weight: 600;
        color: #495057;
        border-bottom: 2px solid #e9ecef;
        font-size: 0.9rem;
    }

    .table tbody tr {
        transition: all 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: rgba(106, 17, 203, 0.03);
        }

    /* آواتار */
    .user-avatar-sm {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .user-avatar-lg {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.4rem;
    }

    /* کارت کاربر در موبایل */
    .user-card {
        transition: all 0.3s ease;
    }

        .user-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px -8px rgba(106, 17, 203, 0.15) !important;
        }

    /* ریسپانسیو */
    @@media (max-width: 768px) {
        .stat-icon {
            width: 50px;
            height: 50px;
        }

            .stat-icon i {
                font-size: 1.4rem !important;
            }

        h2 {
            font-size: 1.5rem;
        }

        .btn-sm {
            font-size: 0.75rem;
            padding: 0.3rem 0.5rem;
        }
    }

    @@media (max-width: 576px) {
        .stat-icon {
            width: 44px;
            height: 44px;
        }

            .stat-icon i {
                font-size: 1.2rem !important;
            }

        h2 {
            font-size: 1.3rem;
        }

        h1.h3 {
            font-size: 1.2rem;
        }

        .user-avatar-lg {
            width: 48px;
            height: 48px;
            font-size: 1.2rem;
        }
    }
</style>