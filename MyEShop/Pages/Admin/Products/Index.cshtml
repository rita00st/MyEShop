@page
@model MyEShop.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "مدیریت محصولات";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- هدر -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">مدیریت محصولات</h1>
            <p class="text-muted mb-0 d-none d-sm-block">مشاهده، فیلتر و مدیریت تمام محصولات فروشگاه</p>
        </div>
        <a href="/Admin/Products/Add" class="btn btn-golden rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> افزودن محصول
        </a>
    </div>

    <!-- کارت‌های آمار -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-purple-10 text-purple rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0"><i class="bi bi-box-seam"></i></span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">کل محصولات</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.TotalProducts.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-success bg-opacity-10 text-success rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0"><i class="bi bi-check2-circle"></i></span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">موجود در انبار</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.InStockCount.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0"><i class="bi bi-exclamation-triangle"></i></span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">ناموجود</small>
                        <h4 class="fw-bold mb-0 text-truncate">@Model.OutOfStockCount.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="bg-purple text-white rounded-3 p-3 fs-4 d-inline-flex flex-shrink-0"><i class="bi bi-cash-stack"></i></span>
                    <div class="flex-grow-1" style="min-width:0;">
                        <small class="text-muted d-block">ارزش انبار (تومان)</small>
                        <h5 class="fw-bold mb-0 text-truncate" title="@Model.TotalInventoryValue.ToString("N0")">
                            @Model.TotalInventoryValue.ToString("N0")
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- پیام‌ها -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3">
            <i class="bi bi-check-circle me-1"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3">
            <i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- کارت اصلی -->
    <div class="card border-0 shadow-sm rounded-4">

        <!-- نوار فیلتر -->
        <div class="card-body border-bottom">
            <form method="get" class="row g-2">
                <div class="col-12 col-lg-4">
                    <input type="search" name="search" value="@Model.SearchTerm"
                           class="form-control rounded-pill"
                           placeholder="جستجو در نام محصول..." />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <select name="categoryId" class="form-select rounded-pill">
                        <option value="">همه دسته‌بندی‌ها</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <select name="sortBy" class="form-select rounded-pill">
                        <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">جدیدترین</option>
                        <option value="oldest" selected="@(Model.SortBy == "oldest" ? "selected" : null)">قدیمی‌ترین</option>
                        <option value="price-asc" selected="@(Model.SortBy == "price-asc" ? "selected" : null)">ارزان‌ترین</option>
                        <option value="price-desc" selected="@(Model.SortBy == "price-desc" ? "selected" : null)">گران‌ترین</option>
                        <option value="name" selected="@(Model.SortBy == "name" ? "selected" : null)">نام (الفبا)</option>
                    </select>
                </div>
                <div class="col-12 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-golden rounded-pill flex-grow-1"><i class="bi bi-funnel me-1"></i> اعمال</button>
                    <a href="/Admin/Products" class="btn btn-outline-secondary rounded-pill px-3" title="پاک‌سازی"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>

        @if (Model.Products.Any())
        {
            <!-- جدول دسکتاپ -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-purple-10">
                        <tr>
                            <th class="px-3 py-3" style="width:40px;"><input type="checkbox" class="form-check-input" id="selectAll" /></th>
                            <th class="px-3 py-3 text-purple fw-semibold">محصول</th>
                            <th class="px-3 py-3 text-purple fw-semibold">دسته‌بندی</th>
                            <th class="px-3 py-3 text-purple fw-semibold">قیمت</th>
                            <th class="px-3 py-3 text-purple fw-semibold">موجودی</th>
                            <th class="px-3 py-3 text-purple fw-semibold text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td class="px-3"><input type="checkbox" class="form-check-input row-check" value="@product.Id" /></td>
                                <td class="px-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(product.ImagePath) ? "/images/no-image.png" : product.ImagePath)"
                                             alt="@product.Name" class="rounded-3 flex-shrink-0"
                                             width="52" height="52" style="object-fit:cover;" />
                                        <div>
                                            <div class="fw-semibold">@product.Name</div>
                                            <small class="text-muted">کد: #@product.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-3">
                                    @if (product.CategoryToProduct != null && product.CategoryToProduct.Any())
                                    {
                                        foreach (var ctp in product.CategoryToProduct.Take(2))
                                        {
                                            <span class="badge bg-purple-10 text-purple rounded-pill px-3 me-1">@ctp.Category?.Name</span>
                                        }
                                        @if (product.CategoryToProduct.Count > 2)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">+@(product.CategoryToProduct.Count - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">بدون دسته</span>
                                    }
                                </td>
                                <td class="px-3 fw-semibold text-nowrap">@product.Item.Price.ToString("N0") <small class="text-muted">تومان</small></td>
                                <td class="px-3 text-nowrap">
                                    @if (product.Item.QuantityInStock > 10)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3"><i class="bi bi-check2-circle me-1"></i>@product.Item.QuantityInStock عدد</span>
                                    }
                                    else if (product.Item.QuantityInStock > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3"><i class="bi bi-exclamation-circle me-1"></i>@product.Item.QuantityInStock عدد</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3"><i class="bi bi-x-circle me-1"></i>ناموجود</span>
                                    }
                                </td>
                                <td class="px-3 text-end text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a href="/Admin/Products/Details/@product.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" title="مشاهده">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Admin/Products/Edit/@product.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="ویرایش">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@product.Id" class="m-0 d-inline-flex" onsubmit="return confirm('آیا از حذف این محصول مطمئن هستید؟');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- کارت موبایل -->
            <div class="d-md-none p-3">
                @foreach (var product in Model.Products)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 bg-purple-10">
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <img src="@(string.IsNullOrEmpty(product.ImagePath) ? "/images/no-image.png" : product.ImagePath)"
                                     alt="@product.Name" class="rounded-3 bg-white p-1 flex-shrink-0"
                                     width="76" height="76" style="object-fit:cover;" />
                                <div class="flex-grow-1" style="min-width:0;">
                                    <h6 class="fw-bold mb-1 text-truncate">@product.Name</h6>
                                    <small class="text-muted d-block mb-2">کد: #@product.Id</small>
                                    @if (product.CategoryToProduct != null && product.CategoryToProduct.Any())
                                    {
                                        <span class="badge bg-white text-purple rounded-pill px-3 text-truncate" style="max-width:100%;">
                                            @product.CategoryToProduct.First().Category?.Name
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                <span class="fw-bold">@product.Item.Price.ToString("N0") <small class="text-muted">تومان</small></span>
                                @if (product.Item.QuantityInStock > 0)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">@product.Item.QuantityInStock عدد</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">ناموجود</span>
                                }
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <a href="/Admin/Products/Edit/@product.Id" class="btn btn-sm btn-outline-primary rounded-pill flex-fill text-nowrap">
                                    <i class="bi bi-pencil-square"></i><span class="d-none d-sm-inline ms-1">ویرایش</span>
                                </a>
                                <a href="/Admin/Products/Details/@product.Id" class="btn btn-sm btn-outline-secondary rounded-pill flex-fill text-nowrap">
                                    <i class="bi bi-eye"></i><span class="d-none d-sm-inline ms-1">جزئیات</span>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@product.Id" class="m-0 flex-fill" onsubmit="return confirm('حذف شود؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill w-100 text-nowrap">
                                        <i class="bi bi-trash"></i><span class="d-none d-sm-inline ms-1">حذف</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- پجینیشن -->
            <div class="card-footer bg-white border-top-0 py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <small class="text-muted">
                        نمایش @Model.Products.Count محصول از @Model.TotalProducts — صفحه @Model.CurrentPage از @Model.TotalPages
                    </small>
                    @if (Model.TotalPages > 1)
                    {
                        <ul class="pagination pagination-sm mb-0 flex-wrap">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3" href="@Model.BuildPageUrl(Model.CurrentPage - 1)">قبلی</a>
                            </li>
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link rounded-pill px-3 @(i == Model.CurrentPage ? "bg-purple text-white border-0" : "")" href="@Model.BuildPageUrl(i)">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3" href="@Model.BuildPageUrl(Model.CurrentPage + 1)">بعدی</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card-body text-center py-5">
                <span class="bg-purple-10 text-purple rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-box-seam display-4"></i>
                </span>
                <h4 class="fw-bold mb-2">هیچ محصولی یافت نشد</h4>
                <p class="text-muted mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue)
                    {
                        <text>نتیجه‌ای برای فیلتر فعلی پیدا نشد. فیلترها را تغییر دهید.</text>
                    }
                    else
                    {
                        <text>اولین محصول خود را اضافه کنید.</text>
                    }
                </p>
                <a href="/Admin/Products/Create" class="btn btn-golden rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>افزودن محصول</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var selectAll = document.getElementById('selectAll');
            if (!selectAll) return;
            selectAll.addEventListener('change', function () {
                document.querySelectorAll('.row-check').forEach(cb => cb.checked = selectAll.checked);
            });
        })();
    </script>
}