@page
@model MyEShop.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "تنظیمات";
    Layout = "_AdminLayout";
}

<!-- ============================================
     هدر صفحه
     ============================================ -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-purple mb-1">
            <i class="bi bi-gear-fill me-2"></i>
            تنظیمات
        </h1>
        <p class="text-muted small mb-0">مدیریت تنظیمات فروشگاه و حساب کاربری</p>
    </div>
    <div>
        <a href="Index"  class="btn btn-outline-purple">
            <i class="bi bi-arrow-right me-1"></i>
            بازگشت به داشبورد
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================
     تب‌های تنظیمات
     ============================================ -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-gradient-purple text-white rounded-top-4 py-3">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-sliders me-2"></i>
            تنظیمات سیستم
        </h5>
    </div>
    <div class="card-body p-0">
        <!-- نوار تب -->
        <ul class="nav nav-tabs nav-fill border-bottom-0 px-3 pt-3" id="settingsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold" id="general-tab" data-bs-toggle="tab"
                        data-bs-target="#general" type="button" role="tab">
                    <i class="bi bi-shop me-1"></i>
                    <span class="d-none d-sm-inline">تنظیمات عمومی</span>
                    <span class="d-sm-none">عمومی</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="payment-tab" data-bs-toggle="tab"
                        data-bs-target="#payment" type="button" role="tab">
                    <i class="bi bi-credit-card me-1"></i>
                    <span class="d-none d-sm-inline">درگاه پرداخت</span>
                    <span class="d-sm-none">پرداخت</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="account-tab" data-bs-toggle="tab"
                        data-bs-target="#account" type="button" role="tab">
                    <i class="bi bi-person-gear me-1"></i>
                    <span class="d-none d-sm-inline">حساب کاربری</span>
                    <span class="d-sm-none">حساب</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="security-tab" data-bs-toggle="tab"
                        data-bs-target="#security" type="button" role="tab">
                    <i class="bi bi-shield-lock me-1"></i>
                    <span class="d-none d-sm-inline">امنیت</span>
                    <span class="d-sm-none">امنیت</span>
                </button>
            </li>
        </ul>

        <!-- محتوای تب‌ها -->
        <div class="tab-content p-3 p-md-4" id="settingsTabsContent">

            <!-- ============================================
                 تب ۱: تنظیمات عمومی
                 ============================================ -->
            <div class="tab-pane fade show active" id="general" role="tabpanel">
                <form method="post" asp-page-handler="SaveGeneral">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-shop text-purple me-1"></i>
                                نام فروشگاه
                            </label>
                            <input asp-for="General.ShopName" class="form-control" placeholder="MyEShop" />
                            <span asp-validation-for="General.ShopName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-envelope text-purple me-1"></i>
                                ایمیل فروشگاه
                            </label>
                            <input asp-for="General.ShopEmail" class="form-control" placeholder="info@myeshop.com" dir="ltr" />
                            <span asp-validation-for="General.ShopEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-telephone text-purple me-1"></i>
                                تلفن تماس
                            </label>
                            <input asp-for="General.ShopPhone" class="form-control" placeholder="021-12345678" />
                            <span asp-validation-for="General.ShopPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-globe text-purple me-1"></i>
                                آدرس فروشگاه
                            </label>
                            <input asp-for="General.ShopAddress" class="form-control" placeholder="تهران، خیابان..." />
                            <span asp-validation-for="General.ShopAddress" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-card-text text-purple me-1"></i>
                                توضیحات فروشگاه
                            </label>
                            <textarea asp-for="General.ShopDescription" class="form-control" rows="3"
                                      placeholder="توضیحات کوتاه درباره فروشگاه"></textarea>
                            <span asp-validation-for="General.ShopDescription" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-golden px-4">
                            <i class="bi bi-check2-circle me-1"></i>
                            ذخیره تنظیمات
                        </button>
                    </div>
                </form>
            </div>

            <!-- ============================================
                 تب ۲: درگاه پرداخت
                 ============================================ -->
            <div class="tab-pane fade" id="payment" role="tabpanel">
                <form method="post" asp-page-handler="SavePayment">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="alert alert-info rounded-3 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        برای فعال‌سازی پرداخت آنلاین، اطلاعات درگاه زرین‌پال را وارد کنید.
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-key-fill text-purple me-1"></i>
                                Merchant ID
                            </label>
                            <input asp-for="Payment.MerchantId" class="form-control"
                                   placeholder="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX" dir="ltr" />
                            <span asp-validation-for="Payment.MerchantId" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-link text-purple me-1"></i>
                                Callback URL
                            </label>
                            <input asp-for="Payment.CallbackUrl" class="form-control"
                                   placeholder="https://localhost:7030/Home/OnlinePayment" dir="ltr" />
                            <span asp-validation-for="Payment.CallbackUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Payment.IsSandbox" id="sandboxMode">
                                <label class="form-check-label fw-semibold" for="sandboxMode">
                                    <i class="bi bi-bug-fill text-warning me-1"></i>
                                    حالت تست (Sandbox)
                                </label>
                            </div>
                            <small class="text-muted">در حالت تست، پرداخت‌ها واقعی نیستند.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-golden px-4">
                            <i class="bi bi-check2-circle me-1"></i>
                            ذخیره تنظیمات
                        </button>
                    </div>
                </form>
            </div>

            <!-- ============================================
                 تب ۳: حساب کاربری
                 ============================================ -->
            <div class="tab-pane fade" id="account" role="tabpanel">
                <form method="post" asp-page-handler="SaveAccount">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-person-fill text-purple me-1"></i>
                                نام کاربری
                            </label>
                            <input asp-for="Account.UserName" class="form-control" dir="ltr" />
                            <span asp-validation-for="Account.UserName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-envelope-fill text-purple me-1"></i>
                                ایمیل
                            </label>
                            <input asp-for="Account.Email" class="form-control" dir="ltr" />
                            <span asp-validation-for="Account.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-image-fill text-purple me-1"></i>
                                لوگو فروشگاه
                            </label>
                            <input type="file" class="form-control" accept="image/*" name="Logo" />
                            <small class="text-muted">فرمت‌های مجاز: JPG, PNG</small>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-palette-fill text-purple me-1"></i>
                                تم رنگی
                            </label>
                            <select class="form-select" asp-for="Account.Theme">
                                <option value="purple">بنفش (پیش‌فرض)</option>
                                <option value="golden">طلایی</option>
                                <option value="teal">فیروزه‌ای</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-golden px-4">
                            <i class="bi bi-check2-circle me-1"></i>
                            ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>

            <!-- ============================================
                 تب ۴: امنیت
                 ============================================ -->
            <div class="tab-pane fade" id="security" role="tabpanel">
                <form method="post" asp-page-handler="ChangePassword">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-lock-fill text-purple me-1"></i>
                                رمز عبور فعلی
                            </label>
                            <input asp-for="Security.CurrentPassword" type="password" class="form-control" />
                            <span asp-validation-for="Security.CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-key-fill text-purple me-1"></i>
                                رمز عبور جدید
                            </label>
                            <input asp-for="Security.NewPassword" type="password" class="form-control" />
                            <span asp-validation-for="Security.NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-key-fill text-purple me-1"></i>
                                تکرار رمز عبور جدید
                            </label>
                            <input asp-for="Security.ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="Security.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-warning rounded-3 mt-4">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        <strong>توجه:</strong> پس از تغییر رمز عبور، باید دوباره وارد حساب خود شوید.
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-golden px-4">
                            <i class="bi bi-shield-check me-1"></i>
                            تغییر رمز عبور
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
@* </div> اصلی تنظیمات</h1> *@