@{
    ViewData["Title"] = "درباره ما | MyEShop";
    Layout = "_Layout";
}

<link href="~/css/aboutusstyle.css" rel="stylesheet" />


<!-- ============================================
     هدر با گرادیانت و انیمیشن
     ============================================ -->
<div class="page-header-about text-center py-5 mb-5">
    <div class="container">
        <span class="badge bg-golden-soft text-dark px-4 py-2 mb-3 rounded-pill">
            <i class="bi bi-info-circle me-1"></i> درباره ما
        </span>
        <h1 class="display-4 fw-bold text-white">
            داستان <span class="text-golden">MyEShop</span>
        </h1>
        <p class="lead text-white-50">با تیم ما آشنا شوید و ببینید چطور می‌توانیم به شما کمک کنیم</p>
    </div>
</div>

<!-- ============================================
     محتوای اصلی با Bootstrap
     ============================================ -->
<div class="container pb-5">

    <!-- بخش داستان -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 text-center about-card">
                <div class="story-icon mx-auto mb-4">
                    <i class="bi bi-shop fs-1 text-white"></i>
                </div>
                <h3 class="fw-bold mb-3">داستان فروشگاه MyEShop</h3>
                <p class="text-muted lh-lg">
                    <strong>MyEShop</strong> با هدف ارائه بهترین تجربه خرید آنلاین و دسترسی آسان به محصولات باکیفیت در سال ۱۴۰۴ آغاز به کار کرد.
                    ما معتقدیم که خرید اینترنتی باید <span class="text-purple fw-semibold">ساده، امن و لذت‌بخش</span> باشد.
                </p>
                <p class="text-muted lh-lg mb-0">
                    فروشگاه ما با بهره‌گیری از جدیدترین فناوری‌های وب و با تمرکز بر نیازهای مشتریان، همواره در تلاش است تا
                    تنوع محصولات را افزایش داده و کیفیت خدمات خود را ارتقا دهد.
                </p>
            </div>
        </div>
    </div>

    <!-- آمار -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-lg-4 h-100 stat-card">
                <div class="stat-icon bg-purple-light-10 rounded-circle mx-auto mb-3">
                    <i class="bi bi-box-seam fs-2 text-purple"></i>
                </div>
                @* <div class="stat-number fs-1 fw-bold text-purple">+۱۰۰۰</div> *@
                <div class="ps-4">
                    <div class="text-purple mb-0 d-inline stat-number fs-1" data-toggle="counter-up">1000</div>
                    <div class="text-purple mb-0 d-inline stat-number fs-1">+</div>
                    <p class="text-muted mb-0">محصول</p>
                </div>
                
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-lg-4 h-100 stat-card">
                <div class="stat-icon bg-golden-light-25 rounded-circle mx-auto mb-3">
                    <i class="bi bi-people fs-2 text-golden-dark"></i>
                </div>
                @* <div class="stat-number fs-1 fw-bold text-golden-dark">+۵۰۰</div> *@
                <div class="ps-4">
                    <div class="text-golden-dark mb-0 d-inline stat-number fs-1 " data-toggle="counter-up">500</div>
                    <div class="text-golden-dark mb-0 d-inline stat-number fs-1 ">+</div>
                    <p class="text-muted mb-0">مشتری</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-lg-4 h-100 stat-card">
                <div class="stat-icon bg-teal-light-10 rounded-circle mx-auto mb-3">
                    <i class="bi bi-star fs-2 text-teal"></i>
                </div>
                @* <div class="stat-number fs-1 fw-bold text-teal">۹۸٪</div> *@
                <div class="ps-4">
                    <div class="text-teal mb-0 d-inline stat-number fs-1 ">%</div>
                    <div class="text-teal mb-0 d-inline stat-number fs-1 " data-toggle="counter-up">98</div>
                    <p class="text-muted mb-0">رضایت</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-lg-4 h-100 stat-card">
                <div class="stat-icon bg-pink-10 rounded-circle mx-auto mb-3">
                    <i class="bi bi-truck fs-2 text-pink"></i>
                </div>
                <div class="stat-number fs-1 fw-bold text-pink" data-toggle="counter-up">24</div>
                <p class="text-muted mb-0">ساعت ارسال</p>
            </div>
        </div>
    </div>

    <!-- مأموریت و چشم‌انداز -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 mission-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-purple rounded-3 p-2">
                        <i class="bi bi-bullseye fs-3 text-white"></i>
                    </div>
                    <h4 class="fw-bold mb-0">مأموریت ما</h4>
                </div>
                <p class="text-muted lh-lg mb-0">
                    فراهم کردن بستری امن، سریع و لذت‌بخش برای خرید آنلاین کاربران ایرانی و ارائه محصولات باکیفیت
                    با قیمت‌های رقابتی و پشتیبانی حرفه‌ای.
                </p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 mission-card">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box-golden rounded-3 p-2">
                        <i class="bi bi-eye fs-3 text-white"></i>
                    </div>
                    <h4 class="fw-bold mb-0">چشم‌انداز ما</h4>
                </div>
                <p class="text-muted lh-lg mb-0">
                    تبدیل شدن به یکی از معتبرترین و محبوب‌ترین فروشگاه‌های اینترنتی ایران با تمرکز بر نوآوری،
                    کیفیت و تجربه کاربری بی‌نظیر.
                </p>
            </div>
        </div>
    </div>

    <!-- ارزش‌های ما -->
    <div class="mb-5">
        <h4 class="fw-bold text-center mb-4">
            <span class="text-purple"><i class="bi bi-heart-fill me-2"></i></span>
            ارزش‌های ما
        </h4>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="value-item d-flex align-items-start gap-3 p-3 rounded-4 border">
                    <i class="bi bi-shield-check fs-2 text-purple"></i>
                    <div>
                        <h6 class="fw-bold mb-1">اعتماد و امنیت</h6>
                        <p class="text-muted small mb-0">اطلاعات شما برای ما امن است و حریم شخصی‌تان را کاملاً محترم می‌شماریم.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="value-item d-flex align-items-start gap-3 p-3 rounded-4 border">
                    <i class="bi bi-star fs-2 text-golden"></i>
                    <div>
                        <h6 class="fw-bold mb-1">کیفیت و تنوع</h6>
                        <p class="text-muted small mb-0">محصولات باکیفیت و متنوع با بهترین قیمت‌ها در اختیار شماست.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="value-item d-flex align-items-start gap-3 p-3 rounded-4 border">
                    <i class="bi bi-headset fs-2 text-indigo"></i>
                    <div>
                        <h6 class="fw-bold mb-1">پشتیبانی حرفه‌ای</h6>
                        <p class="text-muted small mb-0">تیم پشتیبانی ما همواره آماده پاسخگویی و رفع مشکلات شماست.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="value-item d-flex align-items-start gap-3 p-3 rounded-4 border">
                    <i class="bi bi-gem fs-2 text-teal"></i>
                    <div>
                        <h6 class="fw-bold mb-1">ارزش‌آفرینی</h6>
                        <p class="text-muted small mb-0">ما به مشتریان و جامعه‌ای که در آن فعالیت می‌کنیم، ارزش می‌دهیم.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- تیم ما -->
    <div>
        <h4 class="fw-bold text-center mb-4">
            <i class="bi bi-people-fill text-purple me-2"></i>
            تیم ما
        </h4>
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 team-card">
                    <div class="team-avatar bg-purple-light-10 rounded-circle mx-auto mb-3">
                        <i class="bi bi-person fs-1 text-purple"></i>
                    </div>
                    <h6 class="fw-bold mb-1">محبوبه سادات</h6>
                    <span class="text-purple small fw-semibold">توسعه‌دهنده ارشد</span>
                    <p class="text-muted small mt-2 mb-0">مدیریت و توسعه پروژه‌های وب با ASP.NET Core</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 team-card">
                    <div class="team-avatar bg-golden-light-25 rounded-circle mx-auto mb-3">
                        <i class="bi bi-person fs-1 text-golden-dark"></i>
                    </div>
                    <h6 class="fw-bold mb-1">سارا محمدی</h6>
                    <span class="text-golden-dark small fw-semibold">طراح UI/UX</span>
                    <p class="text-muted small mt-2 mb-0">طراحی تجربه کاربری و رابط‌های جذاب فروشگاه</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 team-card">
                    <div class="team-avatar bg-teal-light-10 rounded-circle mx-auto mb-3">
                        <i class="bi bi-person fs-1 text-teal"></i>
                    </div>
                    <h6 class="fw-bold mb-1">علی رضایی</h6>
                    <span class="text-teal small fw-semibold">متخصص دیتابیس</span>
                    <p class="text-muted small mt-2 mb-0">مدیریت و بهینه‌سازی پایگاه داده فروشگاه</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 team-card">
                    <div class="team-avatar bg-pink-dark-10 rounded-circle mx-auto mb-3">
                        <i class="bi bi-person fs-1 text-pink"></i>
                    </div>
                    <h6 class="fw-bold mb-1">نازنین کریمی</h6>
                    <span class="text-pink small fw-semibold">پشتیبانی و محتوا</span>
                    <p class="text-muted small mt-2 mb-0">ارتباط با مشتریان و تولید محتوای فروشگاه</p>
                </div>
            </div>
        </div>


        <!-- بخش تماس -->
        <div class="cta-section">
            <h3>ما را بیشتر بشناسید</h3>
            <p>اگر سوال، پیشنهاد یا انتقادی دارید، خوشحال می‌شویم از شما بشنویم.</p>
            <a asp-controller="Home" asp-action="ContactUs" class="btn-cta">
                <i class="bi bi-envelope me-2"></i>
                تماس با ما
            </a>
        </div>
    </div>
</div>


