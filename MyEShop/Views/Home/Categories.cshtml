@model IEnumerable<MyEShop.Models.Entities.Category>
@{
    ViewData["Title"] = "دسته‌بندی محصولات";
}

<!-- ============================================
     هدر صفحه با گرادیانت
     ============================================ -->
<div class="page-header-categories text-center py-5 mb-5">
    <div class="container">
        <span class="badge bg-golden-soft text-dark px-4 py-2 mb-3 rounded-pill">
            <i class="bi bi-grid-3x3-gap-fill me-1"></i> دسته‌بندی‌ها
        </span>
        <h1 class="display-4 fw-bold text-white mb-2">
            دسته‌بندی <span class="text-golden">محصولات</span>
        </h1>
        <p class="lead text-white-50 mb-0">دسته‌بندی مورد نظر خود را انتخاب کنید</p>
    </div>
</div>

<!-- ============================================
     محتوای اصلی
     ============================================ -->
<div class="container pb-5">

    <!-- جستجو در دسته‌بندی‌ها -->
    <div class="row justify-content-center mb-5">
        <div class="col-12 col-md-6">
            <div class="search-category-box">
                <i class="bi bi-search search-category-icon"></i>
                <input type="text"
                       id="categorySearchInput"
                       class="form-control search-category-input"
                       placeholder="جستجوی دسته‌بندی..."
                       autocomplete="off" />
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- ============================================
             آمار دسته‌بندی‌ها
             ============================================ -->
        <div class="row g-3 g-md-4 mb-5">
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-md-4 stat-card">
                    <div class="stat-icon bg-purple-soft rounded-circle mx-auto mb-3">
                        <i class="bi bi-tags-fill fs-3 text-purple"></i>
                    </div>
                    <h2 class="fw-bold text-purple mb-0">@ViewBag.TotalCategories</h2>
                    <p class="text-muted small mb-0">کل دسته‌بندی‌ها</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-md-4 stat-card">
                    <div class="stat-icon bg-golden-soft rounded-circle mx-auto mb-3">
                        <i class="bi bi-box-seam-fill fs-3 text-golden-dark"></i>
                    </div>
                    <h2 class="fw-bold text-golden-dark mb-0">@ViewBag.TotalProducts</h2>
                    <p class="text-muted small mb-0">کل محصولات</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-md-4 stat-card">
                    <div class="stat-icon bg-teal-soft rounded-circle mx-auto mb-3">
                        <i class="bi bi-star-fill fs-3 text-teal"></i>
                    </div>
                    <h2 class="fw-bold text-teal mb-0 text-truncate px-2">@ViewBag.MostPopularCategory</h2>
                    <p class="text-muted small mb-0">محبوب‌ترین دسته</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3 p-md-4 stat-card">
                    <div class="stat-icon bg-pink-soft rounded-circle mx-auto mb-3">
                        <i class="bi bi-fire fs-3 text-pink"></i>
                    </div>
                    <h2 class="fw-bold text-pink mb-0 text-truncate px-2">@ViewBag.NewestCategory</h2>
                    <p class="text-muted small mb-0">جدیدترین دسته</p>
                </div>
            </div>
        </div>

        <!-- ============================================
             لیست دسته‌بندی‌ها
             ============================================ -->
        <div class="row g-4" id="categoriesContainer">
            @foreach (var category in Model)
            {
                var productCount = category.CategoryToProduct?.Count ?? 0;
                var categoryName = string.IsNullOrWhiteSpace(category.Name) ? "بدون نام" : category.Name;

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3 category-item"
                     data-name="@categoryName.ToLower()">
                    <div class="card border-0 shadow-sm rounded-4 h-100 category-card">
                        <!-- هدر کارت -->
                        <div class="category-card-header bg-gradient-purple text-center py-4">
                            <div class="category-icon-lg bg-white text-purple mx-auto mb-3">
                                <i class="bi bi-tag-fill"></i>
                            </div>
                            <h5 class="text-white fw-bold mb-0 px-2">@categoryName</h5>
                        </div>

                        <!-- بدنه کارت -->
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <!-- توضیحات -->
                            <p class="text-muted small mb-3 flex-grow-1 @(string.IsNullOrWhiteSpace(category.Description) ? "fst-italic" : "")">
                                @(string.IsNullOrWhiteSpace(category.Description)
                                                        ? "توضیحاتی برای این دسته‌بندی ثبت نشده است."
                                                        : category.Description)
                    </p>

                            <!-- آمار -->
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded-3">
                                <div class="text-center flex-grow-1">
                                    <small class="text-muted d-block">تعداد محصولات</small>
                                    <span class="fw-bold text-purple">@productCount</span>
                                </div>
                                <div class="border-end" style="height: 30px;"></div>
                                <div class="text-center flex-grow-1">
                                    <small class="text-muted d-block">شناسه</small>
                                    <span class="fw-bold text-purple">#@category.Id</span>
                                </div>
                            </div>

                            <!-- دکمه مشاهده -->
                            <a asp-controller="Home"
                               asp-action="ShowAllProduct"
                               asp-route-categoryId="@category.Id"
                               class="btn btn-golden w-100">
                                <i class="bi bi-eye-fill me-1"></i>
                                مشاهده محصولات
                            </a>
                        </div>
                    </div>
                </div>
                }
        </div>

        <!-- ============================================
             پیام خالی (در صورت جستجو)
             ============================================ -->
        <div id="noResultsMessage" class="text-center py-5 d-none">
            <i class="bi bi-search fs-1 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">دسته‌بندی یافت نشد!</h5>
            <p class="text-muted small">لطفاً کلمه دیگری را جستجو کنید.</p>
        </div>
    }
    else
    {
        <!-- حالت خالی -->
        <div class="text-center py-5">
            <i class="bi bi-tags fs-1 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">هیچ دسته‌بندی وجود ندارد!</h5>
            <p class="text-muted small">به زودی دسته‌بندی‌های جدید اضافه خواهند شد.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-golden mt-2">
                <i class="bi bi-house-door me-1"></i>
                بازگشت به صفحه اصلی
            </a>
        </div>
    }
</div>

<!-- ============================================
     استایل‌های اختصاصی
     ============================================ -->
<style>
    /* هدر صفحه */
    .page-header-categories {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 50%, #6a11cb 100%);
        background-size: 200% 200%;
        animation: gradientMove 6s ease-in-out infinite alternate;
        border-radius: 0 0 50px 50px;
        box-shadow: 0 10px 40px rgba(106, 17, 203, 0.25);
        position: relative;
        overflow: hidden;
    }

    @@keyframes gradientMove {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 100% 50%;
        }
    }

    .page-header-categories::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(255, 215, 0, 0.15) 0%, transparent 70%);
        border-radius: 50%;
    }

    /* جستجو */
    .search-category-box {
        position: relative;
    }

    .search-category-input {
        border-radius: 50px;
        border: 2px solid #e8e0f0;
        padding: 14px 50px 14px 20px;
        font-size: 1rem;
        transition: all 0.3s;
        background: #faf8ff;
    }

        .search-category-input:focus {
            border-color: #6a11cb;
            box-shadow: 0 0 0 4px rgba(106, 17, 203, 0.08);
            background: #fff;
        }

    .search-category-icon {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #6a11cb;
        font-size: 1.2rem;
        z-index: 2;
    }

    /* کارت‌های آماری */
    .stat-card {
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px -12px rgba(106, 17, 203, 0.15) !important;
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s ease;
    }

    .stat-card:hover .stat-icon {
        transform: scale(1.08) rotate(-5deg);
    }

    /* کارت دسته‌بندی */
    .category-card {
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
    }

        .category-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 60px -12px rgba(106, 17, 203, 0.2) !important;
        }

    .category-card-header {
        position: relative;
    }

        .category-card-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #ffd700, #ffb300);
        }

    /* آیکون دسته‌بندی */
    .category-icon-lg {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        border: 3px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        transition: all 0.4s ease;
    }

    .category-card:hover .category-icon-lg {
        transform: scale(1.1) rotate(-5deg);
    }

    /* فیلتر جستجو */
    .category-item.hidden {
        display: none !important;
    }

    /* ریسپانسیو */
    @@media (max-width: 991.98px) {
        .page-header-categories {
            padding: 2.5rem 0 3rem;
            border-radius: 0 0 30px 30px;
        }

            .page-header-categories h1 {
                font-size: 1.8rem;
            }
    }

    @@media (max-width: 767.98px) {
        .stat-icon {
            width: 50px;
            height: 50px;
        }

            .stat-icon i {
                font-size: 1.4rem !important;
            }

        .category-icon-lg {
            width: 60px;
            height: 60px;
            font-size: 1.6rem;
        }

        h2 {
            font-size: 1.5rem;
        }
    }

    @@media (max-width: 575.98px) {
        .page-header-categories {
            padding: 1.5rem 0 2rem;
            border-radius: 0 0 20px 20px;
        }

            .page-header-categories h1 {
                font-size: 1.4rem;
            }

        .stat-icon {
            width: 44px;
            height: 44px;
        }

            .stat-icon i {
                font-size: 1.2rem !important;
            }

        h2 {
            font-size: 1.3rem;
        }

        .category-icon-lg {
            width: 55px;
            height: 55px;
            font-size: 1.4rem;
        }

        .search-category-input {
            font-size: 0.9rem;
            padding: 12px 45px 12px 15px;
        }
    }
</style>

<!-- ============================================
     اسکریپت جستجوی زنده
     ============================================ -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('categorySearchInput');
            const categoryItems = document.querySelectorAll('.category-item');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const categoriesContainer = document.getElementById('categoriesContainer');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const searchTerm = this.value.trim().toLowerCase();
                    let visibleCount = 0;

                    categoryItems.forEach(item => {
                        const categoryName = item.getAttribute('data-name') || '';
                        if (categoryName.includes(searchTerm)) {
                            item.classList.remove('hidden');
                            visibleCount++;
                        } else {
                            item.classList.add('hidden');
                        }
                    });

                    // نمایش/مخفی کردن پیام خالی
                    if (visibleCount === 0 && searchTerm !== '') {
                        noResultsMessage.classList.remove('d-none');
                        if (categoriesContainer) categoriesContainer.classList.add('d-none');
                    } else {
                        noResultsMessage.classList.add('d-none');
                        if (categoriesContainer) categoriesContainer.classList.remove('d-none');
                    }
                });
            }
        });
    </script>
}