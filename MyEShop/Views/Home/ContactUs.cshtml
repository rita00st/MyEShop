@{
    ViewData["Title"] = "تماس با ما | MyEShop";
    Layout = "_Layout";
}

<!-- فونت وزیرمتن برای زیبایی بیشتر -->
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />

<style>
    /* ============================================
           متغیرهای رنگ
           ============================================ */
    :root {
        --purple-dark: #5a189a;
        --purple-main: #6a11cb;
        --purple-light: #9d4edd;
        --golden: #ffd700;
        --golden-soft: #f7ef8a;
        --shadow-color: rgba(106, 17, 203, 0.1);
    }

    /* ============================================
           هدر صفحه
           ============================================ */
    .page-header-contact {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        padding: 3.5rem 0 4rem;
        border-radius: 0 0 40px 40px;
        position: relative;
        overflow: hidden;
        margin-bottom: 3rem;
    }

        .page-header-contact::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.12) 0%, transparent 70%);
            border-radius: 50%;
        }

        .page-header-contact::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
            border-radius: 50%;
        }

        .page-header-contact h1 {
            color: #fff;
            text-shadow: 0 2px 20px rgba(0,0,0,0.08);
            position: relative;
            z-index: 2;
        }

        .page-header-contact p {
            color: rgba(255,255,255,0.85);
            position: relative;
            z-index: 2;
        }

    /* ============================================
           کارت اطلاعات تماس
           ============================================ */
    .info-card {
        background: #fff;
        border-radius: 24px;
        padding: 1.5rem 1.5rem 1.8rem;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(106, 17, 203, 0.06);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
        height: 100%;
    }

        .info-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 48px -12px var(--shadow-color);
            border-color: rgba(106, 17, 203, 0.08);
        }

        .info-card .icon-wrapper {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(106, 17, 203, 0.08), rgba(37, 117, 252, 0.08));
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.8rem;
            color: var(--purple-main);
            transition: all 0.4s ease;
        }

        .info-card:hover .icon-wrapper {
            background: linear-gradient(135deg, var(--purple-main), #2575fc);
            color: #fff;
            transform: scale(1.05);
            padding-top: 0;

        }

        .info-card h6 {
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 0.25rem;
        }

        .info-card p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 0;
            direction: ltr;
        }

    /* ============================================
           فرم تماس
           ============================================ */
    .contact-form-card {
        background: #fff;
        border-radius: 24px;
        padding: 2rem;
        border: 1px solid rgba(106, 17, 203, 0.06);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

        .contact-form-card .form-control {
            border: 1.5px solid #e8e0f0;
            border-radius: 14px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #faf8ff;
        }

            .contact-form-card .form-control:focus {
                border-color: var(--purple-main);
                box-shadow: 0 0 0 4px rgba(106, 17, 203, 0.06);
                background: #fff;
            }

        .contact-form-card label {
            font-weight: 600;
            color: #1a1a2e;
            font-size: 0.85rem;
            margin-bottom: 0.3rem;
        }

    .btn-send {
        background: linear-gradient(135deg, var(--purple-main), #2575fc);
        color: #fff;
        border: none;
        border-radius: 14px;
        padding: 0.8rem 2.5rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.4s ease;
        box-shadow: 0 4px 20px rgba(106, 17, 203, 0.2);
        width: 100%;
    }

        .btn-send:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 32px rgba(106, 17, 203, 0.3);
            color: #fff;
        }

    /* ============================================
           شبکه‌های اجتماعی
           ============================================ */
    .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        top: 0;
        bottom : 0;
        border-radius: 50%;
        background: #f5f0ff;
        color: var(--purple-main);
        font-size: 1.3rem;
        transition: all 0.3s ease;
        text-decoration: none;
        border: 1px solid rgba(106, 17, 203, 0.06);
    }

        .social-link:hover {
            background: linear-gradient(135deg, var(--purple-main), #2575fc);
            color: #fff;
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 8px 24px rgba(106, 17, 203, 0.2);
        }

    /* ============================================
           نقشه 
           ============================================ */
    .map-container {
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(106, 17, 203, 0.06);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

        .map-container iframe {
            width: 100%;
            height: 300px;
            border: none;
            display: block;
        }

    /* ============================================
           ریسپانسیو
           ============================================ */
    @@media (max-width: 768px) {
        .page-header-contact {
            padding: 2rem 0 2.5rem;
            border-radius: 0 0 30px 30px;
        }

            .page-header-contact h1 {
                font-size: 1.8rem;
            }

        .contact-form-card {
            padding: 1.5rem;
        }

        .info-card {
            padding: 1.2rem;
        }

            .info-card .icon-wrapper {
                width: 52px;
                height: 52px;
                font-size: 1.4rem;
            }

        .btn-send {
            padding: 0.7rem 1.5rem;
        }

        .social-link {
            width: 42px;
            height: 42px;
            font-size: 1.1rem;
        }
    }

    @@media (max-width: 576px) {
        .page-header-contact {
            padding: 1.5rem 0 2rem;
            border-radius: 0 0 20px 20px;
        }

            .page-header-contact h1 {
                font-size: 1.4rem;
            }

        .contact-form-card {
            padding: 1rem;
        }

        .info-card {
            padding: 1rem;
        }
    }
</style>

<!-- ============================================
     هدر صفحه تماس با ما
     ============================================ -->
<div class="page-header-contact text-center">
    <div class="container position-relative" style="z-index: 2;">
        <h1 class="display-4 fw-bold mb-2">
            <i class="bi bi-headset me-2"></i>
            تماس با ما
        </h1>
        <p class="lead mb-0">ما همیشه برای پاسخگویی به شما در دسترس هستیم</p>
    </div>
</div>

<!-- ============================================
     محتوای اصلی
     ============================================ -->
<div class="container pb-5">

    <!-- کارت‌های اطلاعات تماس -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="icon-wrapper">
                    <i class="bi bi-geo-alt pt-1"></i>
                </div>
                <h6>آدرس</h6>
                <p>تهران، خیابان آزادی</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="icon-wrapper">
                    <i class="bi bi-telephone pt-1"></i>
                </div>
                <h6>تلفن</h6>
                <p>۰۲۱-۳۳۴۴۵۵۶</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="icon-wrapper">
                    <i class="bi bi-envelope pt-1"></i>
                </div>
                <h6>ایمیل</h6>
                <p>info@myeshop.com</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="icon-wrapper">
                    <i class="bi bi-clock pt-1"></i>
                </div>
                <h6>ساعت کاری</h6>
                <p>۹ صبح تا ۶ عصر</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- فرم تماس -->
        <div class="col-lg-7">
            <div class="contact-form-card">
                <h4 class="fw-bold mb-1 text-purple">
                    <i class="bi bi-chat-dots me-2"></i>
                    ارسال پیام
                </h4>
                <p class="text-muted small mb-4">لطفاً فرم زیر را پر کنید، در اسرع وقت با شما تماس خواهیم گرفت.</p>

                <form method="post" asp-action="ContactUs" asp-controller="Home">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نام و نام خانوادگی</label>
                            <input type="text" class="form-control" placeholder="نام خود را وارد کنید" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ایمیل</label>
                            <input type="email" class="form-control" placeholder="ایمیل خود را وارد کنید" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">موضوع</label>
                            <input type="text" class="form-control" placeholder="موضوع پیام را وارد کنید" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">پیام</label>
                            <textarea class="form-control" rows="4" placeholder="پیام خود را بنویسید..." required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn-send">
                                <i class="bi bi-send me-2"></i>
                                ارسال پیام
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- بخش شبکه‌های اجتماعی و اطلاعات -->
        <div class="col-lg-5">
            <!-- شبکه‌های اجتماعی -->
            <div class="contact-form-card mb-4 ">
                <h5 class="fw-bold mb-4 ">
                    <i class="bi bi-share me-2 text-purple text-center"></i>
                    ما را دنبال کنید
                </h5>
                <div class="d-flex gap-3 flex-wrap justify-content-center">
                    <a href="#" class="social-link pt-1" aria-label="اینستاگرام"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-link pt-1" aria-label="تلگرام"><i class="bi bi-telegram"></i></a>
                    <a href="#" class="social-link pt-1" aria-label="واتساپ"><i class="bi bi-whatsapp"></i></a>
                    <a href="#" class="social-link pt-1" aria-label="توییتر"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="social-link pt-1" aria-label="آپارات"><i class="bi bi-play-circle"></i></a>
                </div>
                <div class="mt-3 pt-2 border-top">
                    <small class="text-muted d-block text-center">
                        <i class="bi bi-check-circle-fill text-success me-1"></i>
                        پاسخگویی در شبکه‌های اجتماعی
                    </small>
                    <small class="text-muted d-block text-center pt-2">
                        <i class="bi bi-clock-history me-1 "></i>
                        پاسخگویی کمتر از ۲۴ ساعت
                    </small>
                </div>
            </div>

            <!-- پیام کوتاه -->
            <div class="contact-form-card" style="background: linear-gradient(135deg, #f8f9ff 0%, #f0ecff 100%); border-color: rgba(106, 17, 203, 0.08);">
                <div class="text-center">
                    <i class="bi bi-chat-heart fs-1 text-purple mb-2 d-block" style="color: var(--purple-main);"></i>
                    <h6 class="fw-bold">ما گوش شنوا داریم!</h6>
                    <p class="text-muted small mb-0">نظرات، پیشنهادات و انتقادات شما باعث بهبود ما می‌شود.</p>
                </div>
            </div>
        </div>
    </div>
</div>