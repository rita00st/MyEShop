@model MyEShop.Models.ViewModel.ListProduct.DetailsViewModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "جزئیات محصول";
    var product = Model.Product;
    var hasImage = !string.IsNullOrEmpty(product?.ImagePath);
    var inStock = Model.QuantityInStock > 0;
}

@if (product == null)
{
    <div class="container py-5">
        <div class="text-center py-5">
            <span class="bg-purple-10 text-purple rounded-circle d-inline-flex p-4 mb-3">
                <i class="bi bi-box-seam display-1"></i>
            </span>
            <h3 class="fw-bold mb-2">محصول یافت نشد</h3>
            <p class="text-muted mb-4">محصول مورد نظر وجود ندارد یا حذف شده است.</p>
            <a asp-controller="Home" asp-action="Index" class="btn bg-purple text-white rounded-pill px-4">
                <i class="bi bi-arrow-right me-1"></i> بازگشت به فروشگاه
            </a>
        </div>
    </div>
    return;
}

<div class="container py-4">

    <!-- مسیر راهنما -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-purple">خانه</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@product.Name</li>
        </ol>
    </nav>

    <div class="row g-4 mb-4">

        <!-- تصویر محصول -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="ratio ratio-1x1 bg-purple-10">
                    @if (hasImage)
                    {
                        <img src="@product.ImagePath" alt="@product.Name"
                             class="w-100 h-100" style="object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-image display-1 text-purple opacity-50"></i>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- اطلاعات محصول -->
        <div class="col-12 col-lg-6">
            <div class="d-flex flex-column h-100">

                <!-- دسته‌بندی‌ها -->
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    <div class="mb-2">
                        @foreach (var cat in Model.Categories)
                        {
                            <span class="badge bg-purple-10 text-purple rounded-pill px-3 py-2 me-1 mb-1">
                                <i class="bi bi-tag me-1"></i>@cat.Name
                            </span>
                        }
                    </div>
                }

                <h1 class="h2 fw-bold mb-3">@product.Name</h1>

                @if (!string.IsNullOrWhiteSpace(product.Description))
                {
                    <p class="text-muted mb-4">@product.Description</p>
                }

                <!-- کارت قیمت و موجودی -->
                <div class="card border-0 bg-purple-10 rounded-4 p-4 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <small class="text-muted d-block mb-1">قیمت</small>
                            <span class="h3 fw-bold text-purple mb-0">
                                @Model.Price.ToString("N0")
                                <small class="fs-6 text-muted">تومان</small>
                            </span>
                        </div>
                        <div class="text-end">
                            <small class="text-muted d-block mb-1">وضعیت موجودی</small>
                            @if (inStock)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                    <i class="bi bi-check2-circle me-1"></i>@Model.QuantityInStock عدد موجود
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                                    <i class="bi bi-x-circle me-1"></i>ناموجود
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- دکمه‌های عملیات -->
                <div class="d-flex flex-wrap gap-2">
                    @if (inStock)
                    {
                        <a asp-controller="Home" asp-action="AddToCard" asp-route-itemId="@product.ItemId"
                           class="btn bg-purple text-white btn-lg rounded-pill px-4 flex-grow-1">
                            <i class="bi bi-cart-plus me-1"></i> افزودن به سبد خرید
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg rounded-pill px-4 flex-grow-1" disabled>
                            <i class="bi bi-cart-x me-1"></i> ناموجود
                        </button>
                    }
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                        <i class="bi bi-arrow-right me-1"></i> بازگشت
                    </a>
                </div>

                <!-- ویژگی‌های فروشگاه -->
                <div class="row g-2 mt-4 pt-3 border-top">
                    <div class="col-4 text-center">
                        <i class="bi bi-truck text-purple fs-4"></i>
                        <small class="d-block text-muted mt-1">ارسال سریع</small>
                    </div>
                    <div class="col-4 text-center">
                        <i class="bi bi-shield-check text-purple fs-4"></i>
                        <small class="d-block text-muted mt-1">پرداخت امن</small>
                    </div>
                    <div class="col-4 text-center">
                        <i class="bi bi-headset text-purple fs-4"></i>
                        <small class="d-block text-muted mt-1">پشتیبانی</small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- توضیحات کامل -->
    @if (!string.IsNullOrWhiteSpace(product.Description))
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h4 class="h5 fw-bold mb-3">
                    <i class="bi bi-file-text me-2 text-purple"></i>توضیحات محصول
                </h4>
                <p class="text-muted mb-0">@product.Description</p>
            </div>
        </div>
    }


    @{
        var comments = ViewBag.Comments as List<MyEShop.Models.Entities.Comment> ?? new List<MyEShop.Models.Entities.Comment>();
    }

    <!-- بخش نظرات -->
    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <h4 class="h5 fw-bold mb-0">
                    <i class="bi bi-chat-dots me-2 text-purple"></i>
                    نظرات کاربران
                    <span class="badge bg-purple-10 text-purple rounded-pill px-3 ms-2">@comments.Count</span>
                </h4>
            </div>

            <!-- پیام‌ها -->
            @if (TempData["CommentSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3">
                    <i class="bi bi-check-circle me-1"></i>@TempData["CommentSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["CommentError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>@TempData["CommentError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- فرم ثبت نظر -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form method="post" asp-controller="Home" asp-action="AddComment" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Product?.Id" />

                    <label class="form-label fw-semibold">نظر خود را بنویسید</label>
                    <textarea name="text" class="form-control rounded-3 mb-2" rows="3"
                          placeholder="تجربه خود از این محصول را بنویسید..." maxlength="1000" required></textarea>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn bg-purple text-white rounded-pill px-4">
                            <i class="bi bi-send me-1"></i> ثبت نظر
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert bg-purple-10 border-0 rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="text-muted small">
                        <i class="bi bi-info-circle text-purple me-1"></i>
                        برای ثبت نظر ابتدا وارد حساب کاربری خود شوید.
                    </span>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm bg-purple text-white rounded-pill px-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> ورود
                    </a>
                </div>
            }

            <hr />

            <!-- لیست نظرات -->
            @if (comments.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var comment in comments)
                    {
                        var name = string.IsNullOrWhiteSpace(comment.User?.Name) ? "کاربر" : comment.User!.Name!;
                        <div class="bg-purple-10 rounded-4 p-3">
                            <div class="d-flex gap-3">

                                <!-- آواتار -->
                                <span class="bg-purple text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                      style="width:44px;height:44px;">
                                    @if (string.IsNullOrWhiteSpace(comment.User?.Name))
                                    {
                                        <i class="bi bi-person"></i>
                                    }
                                    else
                                    {
                                        @comment.User.Name.Substring(0, 1)
                                    }
                                </span>

                                <!-- محتوای نظر -->
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mb-1">
                                        <span class="fw-semibold text-purple">@name</span>
                                        <small class="text-muted">@comment.CreatedDate.ToString("yyyy/MM/dd HH:mm")</small>
                                    </div>
                                    <p class="mb-0 text-muted" style="white-space: pre-line;">@comment.Text</p>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-chat-square-text display-6 text-muted"></i>
                    <p class="text-muted mt-2 mb-0">هنوز نظری برای این محصول ثبت نشده است. اولین نفر باشید!</p>
                </div>
            }

        </div>
    </div>
</div>