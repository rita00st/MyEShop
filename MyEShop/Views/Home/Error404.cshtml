@{
    ViewData["Title"] = "صفحه یافت نشد";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="error-404">
                <h1 class="display-1 fw-bold text-purple">404</h1>
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
                </div>
                <h2 class="mb-3">صفحه‌ای که به دنبال آن هستید یافت نشد!</h2>
                <p class="text-muted mb-4">
                    متأسفیم، صفحه مورد نظر شما وجود ندارد یا به آدرس دیگری منتقل شده است.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <a href="/" class="btn btn-golden btn-lg">
                        <i class="bi bi-house-door me-2"></i>
                        بازگشت به خانه
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-purple btn-lg">
                        <i class="bi bi-arrow-right me-2"></i>
                        صفحه قبلی
                    </a>
                </div>
                @if (ViewBag.StatusCode != null)
                {
                    <div class="mt-3">
                        <small class="text-muted">کد خطا: @ViewBag.StatusCode</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .error-404 {
        padding: 40px 20px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        border: 1px solid #f0f0f0;
    }

    .error-404 h1 {
        font-size: 8rem;
        font-weight: 900;
        background: linear-gradient(135deg, #6f42c1 0%, #8a2be2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: none;
    }

    .btn-golden {
        background: linear-gradient(135deg, #ffd700 0%, #ffc107 100%);
        color: #333;
        border: none;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-golden:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4);
        color: #333;
    }

    .btn-outline-purple {
        border: 2px solid #6f42c1;
        color: #6f42c1;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-outline-purple:hover {
        background: #6f42c1;
        color: #fff;
        transform: translateY(-3px);
    }
</style>









