@model MyEShop.Models.ViewModel.ProductListViewModel

@{
    ViewData["Title"] = "فروشگاه | مشاهده همه محصولات";
    Layout = "_Layout";
}

@* <!-- فونت وزیرمتن برای زیبایی بیشتر متون فارسی (اگر در _Layout ندارید) -->
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />

<style>
    :root {
        --primary-color: #4f46e5; /* رنگ اصلی بنفش-آبی مدرن */
        --primary-hover: #4338ca;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-muted: #64748b;
    }

    body {
        font-family: 'Vazirmatn', system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
    }

    /* سایدبار چسبان و شیشه‌ای */
    .filter-sidebar {
        position: sticky;
        top: 20px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* استایل فرم‌ها */
    .form-control, .form-select {
        border: 1.5px solid #e2e8f0;
        background-color: #f8fafc;
        transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        background-color: #fff;
    }

    /* کارت محصول حرفه‌ای */
    .product-card {
        background: var(--card-bg);
        border: 1px solid rgba(226, 232, 240, 0.6);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
        border-color: rgba(79, 70, 229, 0.2);
    }

    /* افکت زوم تصویر */
    .img-container {
        overflow: hidden;
        position: relative;
    }
    .img-container img {
        transition: transform 0.6s ease;
    }
    .product-card:hover .img-container img {
        transform: scale(1.08);
    }

    /* محدود کردن متن توضیحات به 2 خط */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* دکمه افزودن به سبد */
    .btn-add-cart {
        background-color: transparent;
        color: var(--primary-color);
        border: 1.5px solid var(--primary-color);
        transition: all 0.3s ease;
    }
    .btn-add-cart:hover {
        background-color: var(--primary-color);
        color: white;
        transform: scale(1.02);
    }

    /* نشانگر موجودی */
    .stock-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-left: 6px;
    }
    .in-stock { background-color: #10b981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.4); }
    .out-of-stock { background-color: #ef4444; }

    /* انیمیشن حالت خالی */
    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
    }
    .empty-state-icon {
        animation: float 3s ease-in-out infinite;
    }
</style>

<div class="container py-5" dir="rtl">
    <!-- هدر صفحه -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-6 fw-bold text-dark mb-2">محصولات فروشگاه</h1>
            <p class="text-muted">بهترین محصولات را با بهترین قیمت کشف کنید</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- سایدبار فیلترها -->
        <div class="col-lg-3">
            <div class="card filter-sidebar shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-sliders2-vertical text-primary ms-2 fs-5"></i>
                    فیلتر پیشرفته
                </h5>
                
                <form asp-action="ShowAllProduct" method="get">
                    <!-- جستجو -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-2">جستجوی محصول</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="SearchTerm" class="form-control border-start-0 ps-0" placeholder="مثلاً: لپ‌تاپ..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <!-- دسته‌بندی -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-2">دسته‌بندی</label>
                        <select name="CategoryId" class="form-select">
                            <option value="">همه دسته‌بندی‌ها</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">
                                    @cat.Name
                                </option>
                            }
                        </select>
                    </div>

                    <!-- محدوده قیمت -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-2">محدوده قیمت (تومان)</label>
                        <div class="d-flex gap-2 mb-2">
                            <div class="w-50">
                                <input type="number" name="MinPrice" class="form-control text-center" placeholder="حداقل" value="@Model.MinPrice" id="minPrice">
                            </div>
                            <div class="d-flex align-items-center text-muted">-</div>
                            <div class="w-50">
                                <input type="number" name="MaxPrice" class="form-control text-center" placeholder="حداکثر" value="@Model.MaxPrice" id="maxPrice">
                            </div>
                        </div>
                        <small id="priceError" class="text-danger small d-none mt-1 fw-semibold">
                            <i class="bi bi-exclamation-circle-fill"></i> حداقل بیشتر از حداکثر است!
                        </small>
                    </div>

                    <!-- دکمه‌ها -->
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-3 shadow-sm" style="background-color: var(--primary-color); border: none;" onclick="return validatePrice()">
                        <i class="bi bi-funnel-fill ms-1"></i> اعمال فیلتر
                    </button>
                    <a asp-action="ShowAllProduct" class="btn btn-light w-100 mt-2 fw-semibold py-2 rounded-3 text-muted">
                        <i class="bi bi-arrow-counterclockwise ms-1"></i> بازنشانی فیلترها
                    </a>
                </form>
            </div>
        </div>

        <!-- شبکه محصولات -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h4 class="fw-bold mb-0 text-dark">
                    <span class="text-primary">@Model.Products.Count</span> محصول یافت شد
                </h4>
                <!-- اینجا می‌توانید بعداً مرتب‌سازی بر اساس قیمت را اضافه کنید -->
            </div>

            @if (Model.Products.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var product in Model.Products)
                    {
                        var firstCategory = product.CategoryToProduct?.FirstOrDefault()?.Category?.Name ?? "عمومی";
                        var isInStock = product.Item != null && product.Item.QuantityInStock > 0;
                        var price = product.Item?.Price ?? 0;

                        <div class="col">
                            <div class="card product-card h-100 rounded-4 overflow-hidden">
                                <!-- بخش تصویر -->
                                <div class="img-container" style="height: 240px; background-color: #f1f5f9;">
                                    @if (!string.IsNullOrEmpty(product.ImagePath))
                                    {
                                        <img src="~/@product.ImagePath" class="w-100 h-100" alt="@product.Name" style="object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                            <i class="bi bi-image display-4 mb-2 opacity-25"></i>
                                            <small>بدون تصویر</small>
                                        </div>
                                    }
                                    
                                    <!-- بج دسته‌بندی -->
                                    <span class="position-absolute top-0 end-0 m-3 px-3 py-1 bg-white text-dark fw-semibold small rounded-pill shadow-sm border">
                                        @firstCategory
                                    </span>

                                    <!-- بج موجودی -->
                                    @if (!isInStock)
                                    {
                                        <div class="position-absolute top-0 start-0 m-3 px-3 py-1 bg-danger text-white fw-bold small rounded-pill shadow-sm">
                                            ناموجود
                                        </div>
                                    }
                                </div>
                                
                                <!-- بخش محتوا -->
                                <div class="card-body d-flex flex-column p-4">
                                    <h5 class="card-title fw-bold text-dark mb-2" style="font-size: 1.1rem;">@product.Name</h5>
                                    <p class="card-text text-muted small line-clamp-2 mb-3 flex-grow-1">
                                        @(string.IsNullOrEmpty(product.Description) ? "توضیحاتی برای این محصول ثبت نشده است." : product.Description)
                                    </p>
                                    
                                    <!-- بخش قیمت و دکمه -->
                                    <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                        <div class="d-flex flex-column">
                                            @if (isInStock)
                                            {
                                                <span class="lh-1">
                                                    <span class="stock-indicator in-stock"></span>
                                                    <small class="text-success fw-semibold me-1">موجود</small>
                                                </span>
                                            }
                                            <span class="fs-5 fw-bolder text-primary mt-1">
                                                @price.ToString("N0") 
                                                <small class="fs-6 text-muted fw-normal">تومان</small>
                                            </span>
                                        </div>
                                        
                                        @if (isInStock)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.Id" class="btn btn-add-cart rounded-3 px-3 py-2 fw-semibold">
                                                <i class="bi bi-cart3 fs-5"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- حالت خالی بودن نتایج -->
                <div class="text-center py-5 my-5 bg-white rounded-4 border border-dashed">
                    <i class="bi bi-search empty-state-icon display-1 text-muted opacity-25 mb-3"></i>
                    <h4 class="fw-bold text-dark">محصولی یافت نشد!</h4>
                    <p class="text-muted mb-4">متأسفانه محصولی با این مشخصات در فروشگاه وجود ندارد. لطفاً فیلترها را تغییر دهید.</p>
                    <a asp-action="ShowAllProduct" class="btn btn-primary px-4 py-2 rounded-3 fw-bold" style="background-color: var(--primary-color); border: none;">
                        مشاهده همه محصولات
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validatePrice() {
            const min = parseFloat(document.getElementById('minPrice').value) || 0;
            const max = parseFloat(document.getElementById('maxPrice').value) || Infinity;
            const errorMsg = document.getElementById('priceError');

            if (min > max) {
                errorMsg.classList.remove('d-none');
                // لرزش خفیف برای جلب توجه
                errorMsg.parentElement.classList.add('animate__animated', 'animate__shakeX');
                setTimeout(() => errorMsg.parentElement.classList.remove('animate__animated', 'animate__shakeX'), 1000);
                return false;
            } else {
                errorMsg.classList.add('d-none');
                return true;
            }
        }
    </script>
} *@






@* @model MyEShop.Models.ViewModels.ShowAllProductsViewModel

@{
    ViewData["Title"] = "فروشگاه | مشاهده همه محصولات";
    Layout = "_Layout";
}

<!-- فونت وزیرمتن -->
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" /> *@
<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">


<!-- فونت وزیرمتن و SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        --primary-hover: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Vazirmatn', system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color);
        background-image: radial-gradient(#e0e7ff 1px, transparent 1px);
        background-size: 24px 24px;
        color: var(--text-main);
    }

    .filter-sidebar {
        position: sticky;
        top: 24px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05);
    }

    .form-control, .form-select {
        border: 1.5px solid var(--border-color);
        background-color: #ffffff;
        border-radius: 12px;
        padding: 10px 14px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .form-control:focus, .form-select:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
        outline: none;
    }

    .product-card {
        background: var(--card-bg);
        border: 1px solid rgba(226, 232, 240, 0.6);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -12px rgba(99, 102, 241, 0.15);
        border-color: rgba(139, 92, 246, 0.3);
    }

    .img-container {
        position: relative;
        height: 240px;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        overflow: hidden;
    }
    .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .product-card:hover .img-container img {
        transform: scale(1.08);
    }

    .badge-category {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        color: var(--text-main);
        font-weight: 600;
        font-size: 0.75rem;
        padding: 6px 12px;
        border-radius: 50px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.6;
    }

    .btn-gradient {
        background: var(--primary-gradient);
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }
    .btn-gradient:hover {
        background: var(--primary-hover);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.35);
    }

    .btn-add-cart {
        background-color: #f1f5f9;
        color: #6366f1;
        border: none;
        border-radius: 12px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        text-decoration: none;
    }
    .btn-add-cart:hover {
        background: var(--primary-gradient);
        color: white;
        transform: scale(1.1);
    }

    .stock-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-left: 6px;
    }
    .in-stock { 
        background-color: #10b981; 
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        animation: pulse-green 2s infinite;
    }
    @@keyframes pulse-green {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeInUp 0.5s ease-out forwards;
    }
</style>

<div class="container py-5" dir="rtl">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-black mb-3" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 900;">
                محصولات فروشگاه
            </h1>
            <p class="text-muted fs-5">بهترین محصولات را با بهترین قیمت کشف کنید</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- سایدبار فیلترها -->
        <div class="col-lg-3">
            <div class="card filter-sidebar rounded-4 p-4">
                <h5 class="fw-bold mb-4 d-flex align-items-center text-dark">
                    <i class="bi bi-sliders2-vertical ms-2 fs-4" style="color: #8b5cf6;"></i>
                    فیلتر پیشرفته
                </h5>
                
                <form asp-action="ShowAllProduct" method="get" id="filterForm">
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-2">جستجوی محصول</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="SearchTerm" class="form-control border-start-0 rounded-end-3" placeholder="مثلاً: لپ‌تاپ..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-2">دسته‌بندی</label>
                        <select name="CategoryId" class="form-select">
                            <option value="">همه دسته‌بندی‌ها</option>
                            @if (Model.Categories != null)
                            {
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">
                                        @cat.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-2">محدوده قیمت (تومان)</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="number" name="MinPrice" class="form-control text-center" placeholder="حداقل" value="@Model.MinPrice" id="minPrice">
                            <span class="text-muted fw-bold">-</span>
                            <input type="number" name="MaxPrice" class="form-control text-center" placeholder="حداکثر" value="@Model.MaxPrice" id="maxPrice">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 fw-bold py-2 mb-2" onclick="return validatePrice()">
                        <i class="bi bi-funnel-fill ms-1"></i> اعمال فیلتر
                    </button>
                    <a asp-action="ShowAllProduct" class="btn btn-light w-100 fw-semibold py-2 text-muted rounded-3">
                        <i class="bi bi-arrow-counterclockwise ms-1"></i> بازنشانی
                    </a>
                </form>
            </div>
        </div>

        <!-- شبکه محصولات -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h4 class="fw-bold mb-0 text-dark">
                    <span style="color: #8b5cf6;">@(Model.Products?.Count ?? 0)</span> محصول یافت شد
                </h4>
            </div>

            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @for (int i = 0; i < Model.Products.Count; i++)
                    {
                        var product = Model.Products[i];
                        var firstCategory = product.CategoryToProduct?.FirstOrDefault()?.Category?.Name ?? "عمومی";
                        var isInStock = product.Item != null && product.Item.QuantityInStock > 0;
                        var price = product.Item?.Price ?? 0;

                        <div class="col animate-fade-in" style="animation-delay: @(i * 0.05)s">
                            <div class="card product-card h-100">
                                <div class="img-container">
                                    @* نکته کلیدی: استفاده از product.ImagePath که در کنترلر پر شده است *@
                                    <img src="~@product.ImagePath" alt="@product.Name" onerror="this.src='/images/no-image.jpg'">
                                    
                                    <span class="badge-category position-absolute top-0 end-0 m-3">
                                        @firstCategory
                                    </span>

                                    @if (!isInStock)
                                    {
                                        <div class="position-absolute top-0 start-0 m-3 px-3 py-1 bg-danger text-white fw-bold small rounded-pill shadow-sm">
                                            ناموجود
                                        </div>
                                    }
                                </div>
                                
                                <div class="card-body d-flex flex-column p-4">
                                    <h5 class="card-title fw-bold text-dark mb-2" style="font-size: 1.1rem; line-height: 1.4;">@product.Name</h5>
                                    <p class="card-text text-muted small line-clamp-2 mb-3 flex-grow-1">
                                        @(string.IsNullOrEmpty(product.Description) ? "توضیحاتی برای این محصول ثبت نشده است." : product.Description)
                                    </p>
                                    
                                    <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                        <div class="d-flex flex-column">
                                            @if (isInStock)
                                            {
                                                <span class="lh-1 mb-1">
                                                    <span class="stock-dot in-stock"></span>
                                                    <small class="text-success fw-semibold me-1">موجود در انبار</small>
                                                </span>
                                            }
                                            <span class="fs-5 fw-black text-dark">
                                                @price.ToString("N0") 
                                                <small class="fs-6 text-muted fw-normal">تومان</small>
                                            </span>
                                        </div>
                                        
                                        @if (isInStock)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.Id" class="btn-add-cart" title="افزودن به سبد خرید">
                                                <i class="bi bi-cart3 fs-5"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 my-5 bg-white rounded-4 border border-dashed">
                    <i class="bi bi-search display-1 text-muted opacity-25 mb-3" style="animation: fadeInUp 1s ease-out;"></i>
                    <h4 class="fw-bold text-dark mb-2">محصولی یافت نشد!</h4>
                    <p class="text-muted mb-4">متأسفانه محصولی با این مشخصات در فروشگاه وجود ندارد.</p>
                    <a asp-action="ShowAllProduct" class="btn btn-gradient px-4 py-2 fw-bold">
                        مشاهده همه محصولات
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function validatePrice() {
            const minInput = document.getElementById('minPrice');
            const maxInput = document.getElementById('maxPrice');
            const min = parseFloat(minInput.value) || 0;
            const max = parseFloat(maxInput.value) || Infinity;

            if (min > max) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا در محدوده قیمت',
                    text: 'حداقل قیمت نمی‌تواند بزرگتر از حداکثر قیمت باشد!',
                    confirmButtonText: 'متوجه شدم',
                    confirmButtonColor: '#6366f1',
                    customClass: {
                        popup: 'rounded-4',
                        title: 'fw-bold'
                    }
                });
                minInput.focus();
                return false;
            }
            return true;
        }
    </script>
}