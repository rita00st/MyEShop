@model IEnumerable<MyEShop.Models.ViewModel.ProductViewModel>
@{
    ViewData["Title"] = ViewBag.CategoryName ?? "محصولات دسته‌بندی";
    var categoryName = ViewBag.CategoryName as string ?? "محصولات";
}

<!-- ============================================
     هدر صفحه
     ============================================ -->
<div class="bg-gradient-purple text-center py-4 mb-4 rounded-bottom-4 shadow-sm">
    <div class="container">
        <h1 class="h3 fw-bold text-white mb-1">
            <i class="bi bi-grid-3x3-gap-fill me-2"></i>
            @categoryName
        </h1>
        <p class="text-white-50 small mb-0">@Model.Count() محصول در این دسته‌بندی</p>
    </div>
</div>

<!-- ============================================
     محتوای اصلی
     ============================================ -->
<div class="container pb-5">

    @if (Model != null && Model.Any())
    {
        <div class="row g-3 g-md-4">
            @foreach (var product in Model)
            {
                // <partial name="Partials/_boxProduct" model="@product" />
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <!-- تصویر -->
                        <div class="bg-light p-3 text-center rounded-top-4">
                            <img src="@(product.ImagePath ?? "/images/no-image.jpg")"
                                 alt="@product.Name"
                                 class="img-fluid"
                                 style="height: 150px; object-fit: contain;"
                                 onerror="this.src='/images/no-image.jpg'" />
                        </div>

                        <!-- محتوا -->
                        <div class="card-body p-2 p-md-3 d-flex flex-column">
                            <h6 class="fw-bold mb-2 text-truncate-2" style="min-height: 42px;">
                                <a asp-controller="Home"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">
                                    @product.Name
                                </a>
                            </h6>

                            <div class="mt-auto pt-2 border-top">
                                <span class="fw-bold text-purple">
                                    @product.Price.ToString("N0")
                                    <small class="text-muted fw-normal">تومان</small>
                                </span>
                            </div>

                            <a asp-controller="Home"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-golden btn-sm w-100 mt-2">
                                <i class="bi bi-eye me-1"></i>
                                مشاهده
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- حالت خالی -->
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">محصولی در این دسته‌بندی وجود ندارد!</h5>
            <p class="text-muted small">به زودی محصولات جدید اضافه خواهند شد.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-golden mt-2">
                <i class="bi bi-house-door me-1"></i>
                بازگشت به صفحه اصلی
            </a>
        </div>
    }
</div>