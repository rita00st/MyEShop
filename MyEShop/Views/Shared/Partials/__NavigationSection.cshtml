<link href="~/css/searchbar.css" rel="stylesheet" asp-append-version="true" />

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-purple shadow-lg fixed-top" >
        <div class="container-fluid">
            <!-- لوگو و برند -->
            <a class="navbar-brand fw-bold fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop"></i>
                <span class="text-golden">My</span>EShop
            </a>

            <!-- دکمه منوی موبایل -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- منوی اصلی -->
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill"></i> خانه
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="ContactUs">
                            <i class="bi bi-envelope-fill"></i> تماس با ما
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle nav-link-custom" href="#" id="categoriesDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill"></i> دسته‌بندی‌ها
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3" aria-labelledby="categoriesDropdown">
                            <li><partial name="Partials/_Group" /></li>
                        </ul>
                    </li>
                </ul>

                <!-- جستجو -->
                @* <form class="d-flex mx-3 position-relative" role="search"> *@
                    @* <input class="form-control search-input rounded-pill px-4" type="search"
                           placeholder="جستجوی محصول..." aria-label="Search" disabled> *@
                    @* <button class="btn btn-search rounded-pill" type="submit">
                        <i class="bi bi-search"></i>
                    </button> *@
                @* </form> *@

                    @* <button type="button" class="btn btn-search rounded-pill  position-relative" data-bs-toggle="modal" data-bs-target="#exampleModalDefault">
                        <i class="bi bi-search"></i>
                    </button> *@

                <!-- بخش کاربری و سبد خرید -->
                <ul class="navbar-nav text-center">

                    <li class="nav-item me-2">
                        <!-- جستجو -->
                        <button type="button" class="mx-2 nav-link cart-link btn btn-search rounded-pill position-relative d-inline-block" data-bs-toggle="modal" data-bs-target="#exampleModalDefault">
                            <i class="bi bi-search"></i>
                        </button>

                        <!-- سبد خرید -->
                        <a class="nav-link position-relative cart-link d-inline-block" asp-controller="Home" asp-action="ShowCart">
                            <i class="bi bi-cart3 fs-4"></i>
                        </a>

                        <!-- احراز هویت -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown d-inline-block">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                                   id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar">
                                        <i class="bi bi-person-circle fs-4"></i>
                                    </div>
                                    <span class="d-none d-lg-inline text-white">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 text-center rounded-3 py-2"
                                    aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" href="/Account/Profile">
                                            <i class="bi bi-person me-2"></i> پروفایل
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="Home/ShowCart">
                                            <i class="bi bi-box-seam me-2"></i> سفارشات
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> خروج
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3 me-2"
                               asp-area="" asp-controller="Account" asp-action="Rejester">
                                ثبت‌نام
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-golden btn-sm rounded-pill px-4"
                               asp-area="" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-left me-1"></i> ورود
                            </a>
                        </li>
                    }
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>



<div class="modal fade" id="exampleModalDefault" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                @* <h5 class="modal-title" id="exampleModalLabel">Modal title</h5> *@
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="close"></button>

                
            </div>
            <div class="modal-body">
                <div class="text-center align-content-center mb-2">
                    <h1><i class="bi bi-search"></i> جستجوی زنده</h1>
                    <p class="text-muted">جستجوی سریع و هوشمند در محصولات</p>
                </div>

                <div class="search-box">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" placeholder="نام محصول را جستجو کنید..." autocomplete="off">
                        <button id="clearBtn" class="clear-btn">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="search-stats">
                        <span id="resultCount">0 نتیجه</span>
                    </div>
                </div>

                <div id="searchResults" class="search-results">
                    <!-- نتایج جستجو اینجا نمایش داده می‌شود -->
                </div>
            </div>

        </div>
    </div>
</div>


<script src="~/js/searchbar.js" asp-append-version="true"></script>