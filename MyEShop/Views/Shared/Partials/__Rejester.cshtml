@model MyEShop.Models.ViewModel.RejesterViewModel


<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card login-card">
                <div class="row g-0">
                    <!-- سمت چپ: توضیحات فروشگاه -->
                    <div class="col-md-5 d-none  d-md-block">
                        <div class="card-side">
                            <div class="text-center">
                                <div class="icon-box mb-4">
                                    <i class="bi bi-bag-heart"></i>
                                </div>
                                <h2 class="side-title">
                                    به <span class="highlight">MyEShop</span><br />خوش آمدید
                                </h2>
                                <p class="side-text mt-3">
                                    بهترین و باکیفیت‌ترین محصولات را با قیمت‌های استثنایی از ما تهیه کنید.
                                    فروشگاهی برای همه سلیقه‌ها!
                                </p>
                            </div>
                            <ul class="feature-list">
                                <li><span class="dot"></span>بیش از ۱۰۰۰ محصول متنوع</li>
                                <li><span class="dot"></span>ارسال سریع و رایگان</li>
                                <li><span class="dot"></span>پشتیبانی ۲۴ ساعته</li>
                                <li><span class="dot"></span>تخفیف‌های ویژه برای اعضا</li>
                            </ul>
                        </div>
                    </div>

                    <!-- سمت راست: فرم‌ها -->
                    <div class="col-md-7">
                        <div class="card-body p-4 ">
                            <!-- رادیوهای مخفی برای کنترل تب -->
                            <input type="radio" name="tab" id="tab-login" class="tab-radio"  />
                            <input type="radio" name="tab" id="tab-register" class="tab-radio" checked />

                            <!-- نوار تب‌ها -->
                            <div class="tab-nav" role="tablist">
                                <a asp-action="Login" asp-controller="Account" for="tab-login" class="tab-btn">ورود به حساب</a>
                                <a asp-action="Rejester" asp-controller="Account" for="tab-register" class="tab-btn">ثبت نام</a>
                                @* <label for="tab-register" class="tab-btn" role="tab">ثبت‌نام</label> *@
                            </div>

                            <!-- فرم ثبت‌نام -->
                            <div class="" >
                                <h3 class="h4 fw-bold mb-1 text-center">ایجاد حساب کاربری 🚀</h3>
                                <p class="text-muted-light small mb-4 mt-3 text-center">با ثبت‌نام، از تخفیف‌های ویژه و امکانات بیشتر بهره‌مند شوید.</p>
                                <form asp-action="Rejester">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control" id="Name" name="Name" placeholder="نام و نام خانوادگی" autocomplete="name">
                                        <label for="Name">نام و نام خانوادگی</label>
                                        <span asp-validation-for="Name" class="text-danger mt-2"></span>

                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control" id="Email" name="Email" placeholder="name@example.com" autocomplete="email" inputmode="email">
                                        <label for="Email">آدرس ایمیل</label>
                                        <span asp-validation-for="Email" class="text-danger mt-2"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="password" class="form-control" id="Password" name="Password" placeholder="حداقل ۸ کاراکتر" autocomplete="new-password">
                                        <label for="Password">رمز عبور</label>
                                        <span asp-validation-for="Password" class="text-danger mt-2"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="password" class="form-control" id="RePassword" name="RePassword" placeholder="رمز را دوباره وارد کنید" autocomplete="new-password">
                                        <label for="RePassword">تکرار رمز عبور</label>
                                        <span asp-validation-for="RePassword" class="text-danger mt-2"></span>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" name="terms" id="termsCheck">
                                        <label class="form-check-label small" for="termsCheck">
                                            با <a class="text-purple" href="#">قوانین و مقررات</a> و <a class="text-purple" href="#">حریم خصوصی</a> فروشگاه موافقم
                                        </label>
                                        <span asp-validation-for="AcceptLaw" class="text-danger mt-2"></span>
                                    </div>
                                    <button type="submit" class="btn btn-primary-custom w-100">
                                        <i class="bi bi-person-plus me-2"></i>ثبت‌نام در فروشگاه
                                    </button>
                                    <p class="text-center text-muted-light small mt-3">با ثبت‌نام، اولین تخفیف خود را دریافت کنید!</p>
                                </form>
                                <p class="text-center mt-3">
                                    قبلاً ثبت‌نام کرده‌اید؟ <a class="text-purple" asp-action="Login" asp-controller="Account">وارد شوید</a>
                                </p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <p class="text-center text-muted-light small mt-3">© ۲۰۲۶ — فروشگاه اینترنتی MyEShop</p>
        </div>
    </div>
</div>
